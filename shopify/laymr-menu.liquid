{%- comment -%} LAYMR short menu: חדש · הנמכרים · לבוש ▾ · אביזרים ▾ · Outlet. Replaces the long flat link row (desktop) and list (mobile menu). {%- endcomment -%}
<style>
.h-nav .hn-g{position:relative;display:inline-flex}
.h-nav .hn-btn{font:inherit;font-size:15.5px;letter-spacing:.03em;font-weight:500;color:inherit;background:none;border:0;padding:4px 0;cursor:pointer;display:inline-flex;align-items:center;gap:6px;opacity:0;transform:translateX(14px);transition:opacity .45s var(--ease),transform .55s var(--ease)}
header.nav-open .h-nav .hn-btn{opacity:1;transform:none}
.hn-btn svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s}
.hn-btn[aria-expanded="true"] svg{transform:rotate(180deg)}
header.nav-open .h-nav{overflow:visible}
.h-nav .hn-sub{position:absolute;top:calc(100% + 12px);right:-18px;min-width:200px;background:var(--bg);color:var(--ink);border:1px solid rgba(46,42,36,.12);box-shadow:0 18px 40px rgba(0,0,0,.12);padding:8px 0;display:none;flex-direction:column;z-index:5}
.h-nav .hn-sub::before{content:'';position:absolute;bottom:100%;left:0;right:0;height:14px}
.h-nav .hn-sub.open{display:flex}
.h-nav .hn-sub a{opacity:1;transform:none;padding:11px 18px;font-size:15px;white-space:nowrap}
.h-nav .hn-sub a::after{display:none}
.h-nav .hn-sub a:hover,.h-nav .hn-sub a:focus-visible{background:rgba(46,42,36,.06)}
.mo-body{overflow-y:auto}
.mo-body a,.mo-body .mo-gbtn{flex:none;height:58px;min-height:0;max-height:none}
.mo-gbtn{display:flex;align-items:center;justify-content:space-between;width:100%;padding:0 var(--pad);font:inherit;font-size:18px;font-weight:500;letter-spacing:.02em;line-height:1;color:var(--ink);background:none;border:0;border-bottom:1px solid rgba(46,42,36,.07);cursor:pointer;text-align:right;opacity:0;transform:translateX(18px);transition:opacity .5s var(--ease),transform .5s var(--ease),background .3s}
.menu-overlay.open .mo-gbtn{opacity:1;transform:none}
.mo-gbtn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round;opacity:.7;transition:transform .3s}
.mo-gbtn[aria-expanded="true"] svg{transform:rotate(180deg)}
.mo-sub{display:none;background:rgba(46,42,36,.035)}
.mo-sub.open{display:block}
.mo-body .mo-sub a{height:50px;font-size:16px;padding-inline-start:calc(var(--pad) + 16px)}
</style>
<script>
(function(){
  var C = function(h){ return '/collections/' + h; };
  var M = [
    {t:'חדש', u:'/collections/all?sort_by=created-descending'},
    {t:'הנמכרים', u:C('best-sellers')},
    {t:'לבוש', c:[
      {t:'חולצות', u:C('%D7%97%D7%95%D7%9C%D7%A6%D7%95%D7%AA')},
      {t:'מכופתרות', u:C('%D7%A7%D7%95%D7%9C%D7%A7%D7%A6%D7%99%D7%99%D7%AA-%D7%97%D7%92')},
      {t:'מכנסיים', u:C('%D7%A7%D7%A4%D7%95%D7%A6%D7%95%D7%A0%D7%99%D7%9D')},
      {t:'חליפות', u:C('%D7%97%D7%9C%D7%99%D7%A4%D7%95%D7%AA')},
      {t:'ספורט', u:C('%D7%A1%D7%A4%D7%95%D7%A8%D7%98')},
      {t:'בגדי ים', u:C('%D7%91%D7%92%D7%93%D7%99-%D7%99%D7%9D')}
    ]},
    {t:'אביזרים', c:[
      {t:'כובעים', u:C('%D7%90%D7%A7%D7%A1%D7%A1%D7%95%D7%A8%D7%99%D7%96')},
      {t:'כל האביזרים', u:C('%D7%92%D7%95%D7%A4%D7%99%D7%95%D7%AA')}
    ]},
    {t:'Outlet', u:C('%D7%A7%D7%95%D7%9C%D7%A7%D7%A6%D7%99%D7%99%D7%AA-%D7%A7%D7%99%D7%A5')}
  ];
  var down = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
  var side = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>';
  var subs = function(n){ return n.c.map(function(s){ return '<a href="' + s.u + '">' + s.t + '</a>'; }).join(''); };
  var hn = document.getElementById('hnav');
  if (hn){
    hn.innerHTML = M.map(function(n, i){ return n.c
      ? '<div class="hn-g"><button type="button" class="hn-btn" aria-expanded="false" aria-controls="hnSub' + i + '">' + n.t + down + '</button><div class="hn-sub" id="hnSub' + i + '">' + subs(n) + '</div></div>'
      : '<a href="' + n.u + '">' + n.t + '</a>'; }).join('');
    var groups = [].slice.call(hn.querySelectorAll('.hn-g'));
    var setG = function(g, open){ g.querySelector('.hn-sub').classList.toggle('open', open); g.querySelector('.hn-btn').setAttribute('aria-expanded', open); };
    var closeAllG = function(except){ groups.forEach(function(g){ if (g !== except) setG(g, false); }); };
    groups.forEach(function(g){
      var b = g.querySelector('.hn-btn');
      b.addEventListener('click', function(e){ e.stopPropagation(); var o = b.getAttribute('aria-expanded') !== 'true'; closeAllG(g); setG(g, o); });
      if (matchMedia('(hover:hover)').matches){
        g.addEventListener('mouseenter', function(){ closeAllG(g); setG(g, true); });
        g.addEventListener('mouseleave', function(){ setG(g, false); });
      }
      g.addEventListener('keydown', function(e){ if (e.key === 'Escape' && b.getAttribute('aria-expanded') === 'true'){ e.stopPropagation(); setG(g, false); b.focus(); } });
      g.addEventListener('focusout', function(e){ if (!g.contains(e.relatedTarget)) setG(g, false); });
    });
    document.addEventListener('click', function(e){ if (!hn.contains(e.target)) closeAllG(); });
  }
  var mo = document.getElementById('moLinks');
  if (mo){
    mo.innerHTML = M.map(function(n, i){ var d = 'transition-delay:' + (0.06 + i * 0.05).toFixed(2) + 's';
      return n.c
        ? '<div class="mo-g"><button type="button" class="mo-gbtn" aria-expanded="false" aria-controls="moSub' + i + '" style="' + d + '"><span>' + n.t + '</span>' + down + '</button><div class="mo-sub" id="moSub' + i + '">' + subs(n) + '</div></div>'
        : '<a href="' + n.u + '" style="' + d + '"><span>' + n.t + '</span>' + side + '</a>'; }).join('');
    [].slice.call(mo.querySelectorAll('.mo-gbtn')).forEach(function(b){
      b.addEventListener('click', function(){ var o = b.getAttribute('aria-expanded') !== 'true'; b.setAttribute('aria-expanded', o); document.getElementById(b.getAttribute('aria-controls')).classList.toggle('open', o); });
    });
  }
})();
</script>
