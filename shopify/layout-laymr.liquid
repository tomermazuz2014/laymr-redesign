<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ page_title }}</title>
    {{ content_for_header }}
  </head>
  <body>
    {{ content_for_layout }}
    {%- comment -%}
    Checkout consent gate (shared by the LAYMR cart page, the cart drawer and every LAYMR page).
    When the terms checkbox added by the TnC app is unchecked, the checkout link does not navigate;
    a clear message asks the customer to approve the terms first. Once the box is checked, checkout works.
    The app itself is not changed.
    {%- endcomment -%}
    <script>
    (function(){
      var MSG = 'יש לאשר את מדיניות הפרטיות והתקנון לפני התשלום';
      document.addEventListener('click', function(e){
        var a = e.target && e.target.closest ? e.target.closest('a.cd-go, a[href="/checkout"], a[href$="/checkout"]') : null;
        if (!a) return;
        var scope = a.closest('#cartDrawer, .cart-drawer, main') || document;
        var cb = scope.querySelector('input[type="checkbox"]');
        if (!cb || cb.checked) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        var m = document.getElementById('laymrConsentMsg');
        if (!m) { m = document.createElement('p'); m.id = 'laymrConsentMsg'; m.setAttribute('role', 'alert'); m.style.cssText = 'color:#b3261e;font-size:13px;margin:10px 0 0;line-height:1.5'; cb.closest('p, label, div') && cb.closest('p, label, div').parentNode ? cb.closest('p, label, div').parentNode.insertBefore(m, cb.closest('p, label, div').nextSibling) : document.body.appendChild(m); }
        m.textContent = MSG;
        cb.focus();
      }, true);
    })();
    </script>
  <style id="laymrA11yCss">
.laymr-a11y-btn{position:fixed;bottom:16px;left:16px;z-index:65;width:44px;height:44px;border:1px solid #121212;border-radius:50%;background:#f3f2ef;color:#121212;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;box-shadow:0 2px 10px rgba(0,0,0,.14)}
.laymr-a11y-btn svg{width:22px;height:22px}
.laymr-a11y-btn:focus-visible,.laymr-a11y-pnl button:focus-visible,.laymr-a11y-pnl a:focus-visible{outline:2px solid #121212;outline-offset:3px}
.laymr-a11y-pnl{position:fixed;bottom:68px;left:16px;z-index:66;width:min(300px,calc(100vw - 32px));background:#f3f2ef;border:1px solid #121212;border-radius:12px;padding:16px;box-shadow:0 8px 28px rgba(0,0,0,.18);direction:rtl;text-align:right;font-family:inherit;color:#121212}
.laymr-a11y-pnl[hidden]{display:none}
.laymr-a11y-pnl h2{margin:0 0 12px;font-size:16px;font-weight:700;line-height:1.3}
.laymr-a11y-pnl ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.laymr-a11y-pnl button{width:100%;font:inherit;font-size:14px;padding:10px 12px;border:1px solid #121212;border-radius:8px;background:transparent;color:#121212;cursor:pointer;text-align:right}
.laymr-a11y-pnl button[aria-pressed="true"]{background:#121212;color:#f3f2ef}
.laymr-a11y-pnl button.laymr-a11y-stm{border-color:transparent;text-decoration:underline;text-underline-offset:3px;padding-inline:4px}
html.laymr-a11y-text{zoom:1.2}
html.laymr-a11y-bottombar .laymr-a11y-btn{bottom:76px}html.laymr-a11y-bottombar .laymr-a11y-pnl{bottom:128px}
html.laymr-a11y-links a{text-decoration:underline!important;text-underline-offset:3px;outline:1px dashed currentColor;outline-offset:2px}
html.laymr-a11y-motion *,html.laymr-a11y-motion *::before,html.laymr-a11y-motion *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
</style>
<button class="laymr-a11y-btn" id="laymrA11yBtn" type="button" aria-label="פתיחת אפשרויות נגישות" aria-expanded="false" aria-controls="laymrA11yPnl">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="7.3" r="1.3" fill="currentColor" stroke="none"/><path d="M7.5 9.6h9M12 9.6v4.1M9.6 19.6l2.4-5.9 2.4 5.9"/></svg>
</button>
<div class="laymr-a11y-pnl" id="laymrA11yPnl" role="dialog" aria-labelledby="laymrA11yTitle" hidden>
  <h2 id="laymrA11yTitle">אפשרויות נגישות</h2>
  <ul>
    <li><button type="button" data-opt="text" aria-pressed="false">הגדלת טקסט</button></li>
    <li><button type="button" data-opt="links" aria-pressed="false">הדגשת קישורים</button></li>
    <li><button type="button" data-opt="motion" aria-pressed="false">הפחתת תנועה</button></li>
    <li><button type="button" data-opt="reset">איפוס ההגדרות</button></li>
    <li><button type="button" class="laymr-a11y-stm" data-opt="statement">הצהרת נגישות</button></li>
  </ul>
</div>
<script>
(function(){
  var KEY='laymr-a11y', root=document.documentElement, state={text:false,links:false,motion:false};
  try{ state=Object.assign(state, JSON.parse(localStorage.getItem(KEY)||'{}')); }catch(e){}
  function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(e){} }
  function apply(){
    root.classList.toggle('laymr-a11y-text', !!state.text);
    root.classList.toggle('laymr-a11y-links', !!state.links);
    root.classList.toggle('laymr-a11y-motion', !!state.motion);
    if(state.motion){ document.querySelectorAll('video').forEach(function(v){ v.pause(); }); }
  }
  var btn=document.getElementById('laymrA11yBtn'), pnl=document.getElementById('laymrA11yPnl');
  if(!btn||!pnl) return;
  function sync(){ pnl.querySelectorAll('[data-opt]').forEach(function(b){ var k=b.getAttribute('data-opt'); if(k in state) b.setAttribute('aria-pressed', String(!!state[k])); }); }
  function open(){ pnl.hidden=false; btn.setAttribute('aria-expanded','true'); var f=pnl.querySelector('button'); if(f) f.focus(); }
  function close(returnFocus){ pnl.hidden=true; btn.setAttribute('aria-expanded','false'); if(returnFocus!==false) btn.focus(); }
  btn.addEventListener('click', function(){ if(pnl.hidden) open(); else close(true); });
  pnl.addEventListener('click', function(e){
    var b=e.target.closest('[data-opt]'); if(!b) return;
    var k=b.getAttribute('data-opt');
    if(k==='reset'){ state={text:false,links:false,motion:false}; save(); apply(); sync(); return; }
    if(k==='statement'){ close(false); var m=document.getElementById('a11yModal'); if(m){ var mo=new MutationObserver(function(){ if(m.hidden){ mo.disconnect(); setTimeout(function(){ if(!document.activeElement||document.activeElement===document.body){ btn.focus(); } },0); } }); mo.observe(m,{attributes:true,attributeFilter:['hidden']}); } var t=document.querySelector('[data-a11y]'); if(t) t.click(); return; }
    state[k]=!state[k]; save(); apply(); sync();
  });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !pnl.hidden){ e.preventDefault(); close(true); } });
  pnl.addEventListener('keydown', function(e){
    if(e.key!=='Tab') return;
    var f=[].slice.call(pnl.querySelectorAll('button')), first=f[0], last=f[f.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  });
  if(document.getElementById('mFilterBtn')) root.classList.add('laymr-a11y-bottombar');
  apply(); sync();
})();
</script>
</body>
</html>
