<script>
(function(){
  var btn=document.getElementById('laymrA11yBtn'), pnl=document.getElementById('laymrA11yPnl');
  if(!btn||!pnl) return;
  var ro=null, watched=null, raf=0, observedRoot=null, ob=null;
  var TOPZ='2147483647';
  function banner(host){
    var best=null;
    (function walk(root){
      root.querySelectorAll('*').forEach(function(e){
        if(e.shadowRoot) walk(e.shadowRoot);
        if(getComputedStyle(e).position!=='fixed') return;
        var r=e.getBoundingClientRect();
        if(r.height>60&&r.height<innerHeight&&r.width>200&&r.top>0&&r.bottom<=innerHeight+1&&r.bottom>innerHeight*0.5&&(best===null||r.top<best.getBoundingClientRect().top)) best=e;
      });
    })(host.shadowRoot);
    return best;
  }
  /* top edge of the banner's own buttons, so nothing of ours ever covers them */
  function controlsTop(el, fallback){
    var t=Infinity;
    el.querySelectorAll('button').forEach(function(b){ var r=b.getBoundingClientRect(); if(r.width&&r.height) t=Math.min(t,r.top); });
    return t===Infinity?fallback:t;
  }
  function hasFocus(n){ return n===document.activeElement||n.contains(document.activeElement); }
  /* the banner can sit in the browser's top layer, where z-index cannot beat it;
     while it is open our button and panel join the top layer too (manual popovers, no light dismiss) */
  var canTop=typeof btn.showPopover==='function';
  function toTop(n, again){
    if(!canTop) return;
    if(!n.hasAttribute('popover')) n.setAttribute('popover','manual');
    try{
      if(n.matches(':popover-open')){ if(!again||hasFocus(n)) return; n.hidePopover(); }
      n.showPopover();
    }catch(e){}
  }
  function fromTop(n){
    if(!n.hasAttribute('popover')) return;
    try{ if(n.matches(':popover-open')) n.hidePopover(); }catch(e){}
    n.removeAttribute('popover');
  }
  /* fallback for browsers without popovers: come after the banner in the DOM so equal z-index stacks above it */
  function raise(host){
    if(canTop) return;
    [btn,pnl].forEach(function(n){
      if(hasFocus(n)) return;
      if(host.compareDocumentPosition(n)&Node.DOCUMENT_POSITION_PRECEDING) document.body.appendChild(n);
    });
  }
  var PROPS=['top','right','bottom','left','margin','width','maxHeight','overflowY','zIndex'];
  function reset(){ PROPS.forEach(function(p){ btn.style[p]=''; pnl.style[p]=''; }); }
  function place(){
    raf=0;
    var host=document.querySelector('csm-cookie-consent');
    if(host&&host.shadowRoot&&observedRoot!==host.shadowRoot){
      observedRoot=host.shadowRoot;
      if(ob) ob.disconnect();
      ob=new MutationObserver(schedule);
      ob.observe(observedRoot,{childList:true,subtree:true,attributes:true});
    }
    var el=host&&host.shadowRoot?banner(host):null;
    if(!el){
      fromTop(btn); fromTop(pnl); reset();
      if(ro){ ro.disconnect(); ro=null; }
      watched=null;
      return;
    }
    var fresh=watched!==el;
    reset();
    raise(host);
    var H=innerHeight, top=el.getBoundingClientRect().top, ctl=controlsTop(el, top), BH=44, M=8;
    [btn,pnl].forEach(function(n){ n.style.zIndex=TOPZ; n.style.top='auto'; n.style.right='auto'; n.style.margin='0'; });
    pnl.style.overflowY='auto';
    /* button: just above the banner when there is room, otherwise just above the banner's buttons */
    var btnBottom=(top>=BH+12+M)?(H-top+12):(H-ctl+M);
    btn.style.bottom=Math.round(btnBottom)+'px';
    var btnTop=H-btnBottom-BH;
    if(btnTop-M-M>=200){
      /* enough height above the button: open upwards, scroll inside if needed */
      pnl.style.bottom=Math.round(btnBottom+BH+M)+'px';
      pnl.style.maxHeight=Math.round(btnTop-M-M)+'px';
    } else {
      /* short screen: open beside the button, between the top edge and the banner's buttons */
      pnl.style.left=(16+BH+M)+'px';
      pnl.style.width='min(300px, calc(100vw - '+(16+BH+M+16)+'px))';
      pnl.style.top=M+'px';
      pnl.style.bottom=Math.round(H-ctl+M)+'px';
      pnl.style.maxHeight=Math.max(120,Math.round(ctl-M-M-M))+'px';
    }
    toTop(btn, fresh); toTop(pnl, fresh);
    if(fresh){ if(ro) ro.disconnect(); ro=new ResizeObserver(schedule); ro.observe(el); watched=el; }
  }
  function schedule(){ if(!raf) raf=requestAnimationFrame(place); }
  new MutationObserver(schedule).observe(document.body,{childList:true,subtree:true});
  addEventListener('resize',schedule,{passive:true});
  place();
})();
</script>
