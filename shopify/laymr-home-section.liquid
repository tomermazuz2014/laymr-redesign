<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Sans+Hebrew:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ===== Ploni — פונט עברית (רישיון הלקוח) ===== */
@font-face{font-family:'Ploni';src:url('https://cdn.shopify.com/s/files/1/0906/9717/1315/files/ploni-regular.woff2?v=1794398740') format('woff2');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Ploni';src:url('https://cdn.shopify.com/s/files/1/0906/9717/1315/files/ploni-medium.woff2?v=1794398740') format('woff2');font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:'Ploni';src:url('https://cdn.shopify.com/s/files/1/0906/9717/1315/files/ploni-demibold.woff2?v=1794398740') format('woff2');font-weight:600;font-style:normal;font-display:swap}
@font-face{font-family:'Ploni';src:url('https://cdn.shopify.com/s/files/1/0906/9717/1315/files/ploni-bold.woff2?v=1794398740') format('woff2');font-weight:700;font-style:normal;font-display:swap}

/* ============ TOKENS ============ */
:root{
  --font-he:'Ploni','IBM Plex Sans Hebrew',-apple-system,'Segoe UI',Arial,sans-serif;
  --font-lat:'Archivo','IBM Plex Sans Hebrew',Arial,sans-serif;

  --bg:#f3f2ef;          /* נייר חם, לא לבן סטרילי */
  --ink:#121212;
  --muted:#6a6a66;
  --line:#dcdad4;
  --line-strong:#121212;
  --warm:#b3a492;
  --warm-line:#a2947f;
  --warm-ink:#2e2a24;
  --white:#fdfdfc;

  --space-1:.25rem; --space-2:.5rem; --space-3:.75rem; --space-4:1rem;
  --space-6:1.5rem; --space-8:2rem; --space-12:3rem; --space-16:4rem; --space-24:6rem;

  --micro:11px;
  --ease:cubic-bezier(.16,1,.3,1);          /* ease-out-expo */
  --ease-io:cubic-bezier(.76,0,.24,1);
  --dur:.5s;
  --pad:clamp(16px,3vw,48px);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--font-he);background:var(--bg);color:var(--ink);font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
::selection{background:var(--ink);color:var(--bg)}
:focus-visible{outline:1.5px solid var(--ink);outline-offset:3px}

.lat{font-family:var(--font-lat)}
.micro{font-size:var(--micro);letter-spacing:.14em;text-transform:uppercase;font-weight:500}
.micro-he{font-size:12px;letter-spacing:.06em;font-weight:500}

/* ============ קו עליון — טיקר ============ */
.ticker{background:var(--warm);border-bottom:1px solid var(--warm-line);overflow:hidden;display:flex;user-select:none}
.ticker__inner{display:flex;flex-shrink:0;align-items:center;gap:0;animation:marquee 36s linear infinite;direction:ltr;will-change:transform;transform:translateZ(0)}
.ticker:hover .ticker__inner{animation-play-state:paused}
.ticker span{display:inline-block;padding:10px 2.6rem 10px 0;font-size:14px;letter-spacing:.1em;white-space:nowrap;color:var(--ink);font-weight:500}
.ticker span::after{content:'·';margin-right:2.6rem;color:rgba(18,18,18,.55)}
@keyframes marquee{to{transform:translateX(-100%)}}

/* ============ Header ============ */
header{position:fixed;top:0;right:0;left:0;z-index:70;color:#fff;background:transparent;border-bottom:1px solid transparent;transition:color .35s,background .35s,border-color .35s}
header.scrolled{color:var(--ink);background:color-mix(in srgb,var(--warm) 92%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--warm-line)}
.header-row{display:flex;align-items:center;justify-content:space-between;padding:0 var(--pad);height:52px;gap:16px}
.h-start{display:flex;align-items:center;gap:18px;min-width:0}
.h-nav{display:flex;gap:clamp(12px,1.3vw,22px);white-space:nowrap}
@media(min-width:1181px){
.h-nav{max-width:0;overflow:hidden;opacity:0;transition:max-width .7s var(--ease),opacity .4s;pointer-events:none}
.h-nav a{opacity:0;transform:translateX(14px);transition:opacity .45s var(--ease),transform .55s var(--ease)}
header.nav-open .h-nav{max-width:900px;opacity:1;pointer-events:auto}
header.nav-open .h-nav a{opacity:1;transform:none}
header.nav-open .h-nav a:nth-child(1){transition-delay:.05s}header.nav-open .h-nav a:nth-child(2){transition-delay:.09s}header.nav-open .h-nav a:nth-child(3){transition-delay:.13s}header.nav-open .h-nav a:nth-child(4){transition-delay:.17s}header.nav-open .h-nav a:nth-child(5){transition-delay:.21s}header.nav-open .h-nav a:nth-child(6){transition-delay:.25s}header.nav-open .h-nav a:nth-child(7){transition-delay:.29s}header.nav-open .h-nav a:nth-child(8){transition-delay:.33s}header.nav-open .h-nav a:nth-child(9){transition-delay:.37s}header.nav-open .h-nav a:nth-child(10){transition-delay:.41s}
}
.menu-toggle svg path{transition:transform .4s var(--ease),opacity .3s;transform-origin:12px 12px}
header.nav-open .menu-toggle .l1{transform:translateY(6px) rotate(45deg)}
header.nav-open .menu-toggle .l2{opacity:0}
header.nav-open .menu-toggle .l3{transform:translateY(-6px) rotate(-45deg)}
.h-nav a{font-size:15.5px;letter-spacing:.03em;font-weight:500;position:relative;padding:4px 0}
.h-nav a::after{content:'';position:absolute;bottom:0;right:0;height:1px;width:0;background:currentColor;transition:width .35s var(--ease)}
.h-nav a:hover::after{width:100%}
.hic{display:block;padding:7px}
.hic svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.5;display:block}
.hic:hover{opacity:.55}
.menu-toggle svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.5;display:block}
.h-mark{font-family:var(--font-lat);font-weight:800;font-stretch:115%;letter-spacing:.02em;font-size:15px;direction:ltr;position:relative;display:flex;align-items:center;justify-content:center}
.h-mark-text{transition:opacity .25s;text-shadow:0 1px 10px rgba(0,0,0,.4)}
.h-mark-logo{position:absolute;inset:0;margin:auto;height:26px;width:auto;opacity:0;transition:opacity .25s}
header.scrolled .h-mark-text{opacity:0}
header.scrolled .h-mark-logo{opacity:1}
.h-util{display:flex;gap:18px;align-items:center}
.menu-toggle{display:block;padding:6px;margin-right:-6px;border:0;background:transparent;color:inherit;cursor:pointer;outline:none}
.menu-toggle:focus-visible{outline:1px solid currentColor;outline-offset:2px}
@media(max-width:1180px){
  .h-nav{display:none}
}

/* ============ וורדמארק ענק + Hero ============ */
.masthead{position:relative}
.hero{position:relative;overflow:hidden;background:#e7e5e0}
.vposter{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
.hero > .vposter{object-position:68% 22%}
.hrep-photo .vposter{object-position:center 22%}
.about-media .vposter{object-position:50% 0}
video.vfade{opacity:0;transition:opacity .7s var(--ease)}
video.vfade.playing{opacity:1}
.hero video{position:relative;z-index:1}
.hrep-photo video{position:relative;z-index:0}
.about-video{position:relative;z-index:1}
@media(max-width:700px){.hero > .vposter{object-position:50% 20%}.hrep-photo .vposter{object-position:center 30%}}
.hero video{width:100%;height:100vh;height:100svh;object-fit:cover;object-position:68% 22%;display:block;background:#e7e5e0}
.hero-campaign{position:absolute;bottom:calc(var(--pad) + 6px);left:var(--pad);z-index:3;color:#fff;direction:ltr;text-align:left}
@media(max-width:700px){.hero-campaign{bottom:calc(var(--pad) + 86px)}}
.hc-kick{display:block;text-shadow:0 1px 12px rgba(0,0,0,.5);font-family:var(--font-lat);font-size:clamp(10px,.95vw,14px);font-weight:500;letter-spacing:.48em;text-transform:uppercase;opacity:0;margin:0 0 clamp(10px,1.1vw,16px) 6px;animation:hcUp .9s var(--ease) .95s forwards}.hc-line{filter:drop-shadow(0 1px 10px rgba(0,0,0,.38));display:flex;align-items:flex-end;gap:.18em;font-family:var(--font-lat);font-stretch:66%;font-weight:800;font-size:clamp(84px,14vw,236px);line-height:.82;letter-spacing:-.005em}.hc-w{display:inline-flex}.hc-ch{display:inline-block;overflow:hidden;padding-bottom:.06em}.hc-ch > span{display:block;transform:translateY(112%);opacity:0;animation:hwUp .9s var(--ease) forwards;animation-delay:calc(.45s + var(--i) * .055s)}.hc-ch i{display:block;font-style:normal;animation:hcFloat 5s ease-in-out infinite;animation-delay:calc(var(--i) * -.55s)}@keyframes hcFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-.035em)}}.hc-w.hollow i{color:transparent;-webkit-text-stroke:clamp(1.4px,.18vw,2.8px) #fff;animation:hcFloat 5s ease-in-out infinite,hcFill 3.4s ease-in-out infinite;animation-delay:calc(var(--i) * -.55s),calc(1.6s + var(--i) * .06s)}@keyframes hcFill{0%,44%,100%{color:transparent}50%,94%{color:#fff}}.hc-w.solid i{color:#fff;-webkit-text-stroke:clamp(1.4px,.18vw,2.8px) #fff;animation:hcFloat 5s ease-in-out infinite,hcSwap 3.4s ease-in-out infinite;animation-delay:calc(var(--i) * -.55s),calc(1.6s + var(--i) * .06s)}@keyframes hcSwap{0%,44%,100%{color:#fff}50%,94%{color:transparent}}@keyframes hcUp{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
.hc-sub{font-family:var(--font-lat);font-size:clamp(10px,1.2vw,15px);letter-spacing:.28em;margin-top:14px;font-weight:600}
.hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(10,10,10,.66),rgba(10,10,10,.32) 34%,transparent 62%);pointer-events:none}
.hero::before{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(10,10,10,.55),transparent 18%);pointer-events:none;z-index:1}
.hero-meta{position:absolute;bottom:0;right:0;left:0;z-index:3;display:flex;justify-content:flex-start;align-items:flex-end;padding:var(--pad);color:#fff}
.hero-cta{font-size:13.5px;letter-spacing:.08em;border:1px solid #fff;border-radius:999px;padding:13px 32px;white-space:nowrap;transition:background .3s,color .3s;backdrop-filter:blur(3px);text-shadow:0 1px 10px rgba(0,0,0,.45)}
.hero-cta:hover{background:#fff;color:var(--ink)}

/* ============ מקטעים ============ */
.section{padding:0 var(--pad)}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:clamp(40px,7vw,86px) 0 clamp(16px,2.4vw,26px);border-bottom:1px solid var(--line-strong)}
.section-head .idx{font-family:var(--font-lat);font-size:var(--micro);letter-spacing:.14em;color:var(--muted);display:block;margin-bottom:10px;direction:ltr;text-align:right}
.section-head h2{font-size:clamp(34px,6vw,76px);font-weight:600;line-height:.95;letter-spacing:-.01em}
.section-head h2.lat{font-weight:800;font-stretch:112%;letter-spacing:0}
.section-head .view-all{font-size:12.5px;letter-spacing:.06em;white-space:nowrap;border-bottom:1px solid var(--ink);padding-bottom:3px;margin-bottom:6px;transition:opacity .3s}
.section-head .view-all:hover{opacity:.55}

/* גריד מוצרים עם קווים דקים */
.pgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border-bottom:1px solid var(--line)}
@media(max-width:1060px){.pgrid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:720px){.pgrid{grid-template-columns:repeat(2,1fr)}}
.pcard{background:var(--bg);display:flex;flex-direction:column;position:relative;transition:background .4s}
.pcard:hover{background:var(--white)}
.pmedia{position:relative;overflow:hidden;aspect-ratio:3/4;background:#e9e7e2}
.pmedia img{width:100%;height:100%;object-fit:cover;transition:opacity .55s var(--ease),transform .9s var(--ease)}
.pmedia .alt{position:absolute;inset:0;opacity:0}
@media(hover:hover){
  .pcard:hover .pmedia .alt{opacity:1}
  .pcard:hover .pmedia .main{transform:scale(1.04)}
}
.ptag{position:absolute;top:10px;inset-inline-start:10px;font-family:var(--font-lat);font-size:10px;letter-spacing:.14em;background:var(--bg);padding:4px 8px;direction:ltr}
.soldout .pmedia img{filter:grayscale(.85);opacity:.6}
.soldout-band{position:absolute;inset-inline:0;top:50%;transform:translateY(-50%);text-align:center;font-size:11px;letter-spacing:.2em;padding:8px 0;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(2px)}
.pinfo{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:12px 14px 16px}
.pname{font-size:13px;font-weight:500;line-height:1.35}
.pcolors{font-size:11px;color:var(--muted);display:block;margin-top:3px}
.pprice{text-align:left;white-space:nowrap;font-size:13px}
.pprice .was{display:block;color:var(--muted);text-decoration:line-through;font-size:11px}
.pprice .now{font-weight:600}

/* ===== טיילים נקיים עם וידאו מוביל ===== */
.tile-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px;margin-inline:calc(-1*var(--pad))}#tiles-new{margin-top:0}
@media(max-width:720px){.tile-grid{grid-template-columns:repeat(2,1fr);gap:8px;margin-top:8px}}
.tile{position:relative;display:block;aspect-ratio:1/1;overflow:hidden;background:#e9e7e2}
.tile img,.tile video{width:100%;height:100%;object-fit:cover;object-position:center 15%;transition:transform .8s var(--ease)}
.tile:hover img,.tile:hover video{transform:scale(1.045)}
.tile-lead::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(10,10,10,.55),rgba(10,10,10,.18) 38%,transparent 60%);pointer-events:none}
.tile-title{text-shadow:0 1px 12px rgba(0,0,0,.45);position:absolute;bottom:clamp(14px,1.4vw,24px);left:clamp(14px,1.4vw,24px);right:14px;z-index:2;color:#fff;font-family:var(--font-lat);direction:ltr;text-align:left;display:flex;flex-direction:column;gap:clamp(8px,.8vw,13px);pointer-events:none}.tt-kick{display:flex;align-items:center;gap:10px;font-size:clamp(9px,.72vw,11px);font-weight:500;letter-spacing:.42em;text-transform:uppercase;white-space:nowrap}.tt-kick i{display:block;width:22px;height:1px;background:currentColor;flex:none}.tt-main{display:flex;flex-direction:column;align-items:flex-start;font-stretch:118%;font-size:clamp(30px,3.6vw,64px);line-height:.82;letter-spacing:-.03em}.tt-solid{font-weight:860}.tt-hollow{font-weight:800;font-style:italic;color:transparent;-webkit-text-stroke:clamp(1px,.12vw,2px) #fff;padding-left:.05em;transition:color .5s var(--ease)}.tile-lead:hover .tt-hollow{color:#fff}.tt-kick,.tt-main{opacity:0;transform:translateY(22px);transition:opacity .9s var(--ease),transform .9s var(--ease)}.in .tt-main{opacity:1;transform:none;transition-delay:.35s}.in .tt-kick{opacity:.92;transform:none;transition-delay:.6s}

/* ===== קרוסלת מוצרים ===== */
.pcar-wrap{margin-top:clamp(40px,6vw,80px);padding-bottom:clamp(64px,7vw,110px)}
/* גודל הכרטיס נגזר מגובה המסך: הפריט המרכזי (x1.5) נכנס בשלמותו מתחת להדר */
.pcar{--pw:clamp(150px,calc((100vh - 330px)/2),320px);overflow:hidden;padding:calc(var(--pw)/3 + 8px) 0}
.pcar-track{display:flex;gap:clamp(14px,2vw,26px);transition:transform .65s var(--ease);align-items:center}
.pcar-item{position:relative;flex:0 0 var(--pw);aspect-ratio:3/4;background:transparent;transform:scale(.56);transition:transform .7s var(--ease);cursor:pointer}
@media (prefers-reduced-motion: reduce){.pcar-track,.pcar-track .pcar-item{transition:none !important}}
@media(max-width:720px){.pcar{--pw:clamp(150px,min(56vw,calc((100vh - 330px)/2)),320px)}}
.pcar-item.is-center{transform:scale(1.5);z-index:2}.pcar-track.noanim,.pcar-track.noanim .pcar-item{transition:none}
.pcar-item img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
.pcar-bottom{display:flex;flex-direction:column;align-items:center;gap:16px;margin-top:14px}
.pcar-nav{display:flex;align-items:center;gap:14px}
.pcar-nav button{width:42px;height:42px;border:1px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;transition:background .3s,color .3s}
.pcar-nav button:hover{background:var(--ink);color:var(--bg)}
.pcar-count{font-family:var(--font-lat);font-size:12px;letter-spacing:.12em;color:var(--muted);min-width:64px;text-align:center}
.pcar-all{background:var(--ink);color:var(--bg);border-radius:999px;padding:13px 32px;font-size:13.5px;letter-spacing:.05em;transition:opacity .3s}
.pcar-all:hover{opacity:.85}

/* ============ אינדקס קולקציות ============ */
.cindex{margin-top:clamp(56px,9vw,120px);border-top:1px solid var(--line-strong)}
.crow{display:flex;align-items:baseline;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);padding:clamp(14px,2.4vw,26px) 0;position:relative;transition:padding-inline-start .5s var(--ease)}
.crow:hover{padding-inline-start:clamp(10px,2vw,28px)}
.crow .cname{font-size:clamp(30px,5.4vw,70px);font-weight:600;line-height:1;letter-spacing:-.01em}
.crow .cname.lat{font-weight:800;font-stretch:112%}
.crow .cmeta{font-size:var(--micro);letter-spacing:.12em;color:var(--muted);white-space:nowrap;transition:color .3s}
.crow:hover .cmeta{color:var(--ink)}
.cpreview{position:fixed;z-index:60;width:min(300px,26vw);aspect-ratio:3/4;object-fit:cover;pointer-events:none;opacity:0;transform:scale(.96);transition:opacity .4s var(--ease),transform .4s var(--ease);top:50%;left:var(--pad);translate:0 -50%}
.cpreview.show{opacity:1;transform:scale(1)}
@media(max-width:960px),(hover:none){.cpreview{display:none}}

/* ============ SHOP THE LOOK ============ */
.look{display:grid;grid-template-columns:7fr 5fr;gap:clamp(20px,3.4vw,56px);align-items:start;padding-top:clamp(20px,3vw,36px)}
@media(max-width:860px){.look{grid-template-columns:1fr}}
.look-media{position:relative;overflow:hidden;background:#e9e7e2}
.look-media img{width:100%;aspect-ratio:4/5;object-fit:cover;transition:opacity .6s var(--ease)}
.look-side{position:sticky;top:76px}
.look-items{border-top:1px solid var(--line-strong)}
.litem{display:flex;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
.litem img{width:72px;height:92px;object-fit:cover;background:#e9e7e2}
.litem .pname{font-size:14px}
.litem .add{font-size:12px;letter-spacing:.06em;border-bottom:1px solid var(--ink);padding-bottom:2px;margin-top:8px;display:inline-block;transition:opacity .3s}
.litem .add:hover{opacity:.55}
.look-nav{display:flex;align-items:center;gap:18px;margin-top:18px}
.look-nav button{font-size:12.5px;letter-spacing:.06em;border-bottom:1px solid transparent;transition:border-color .3s}
.look-nav button:hover{border-color:var(--ink)}
.look-count{font-family:var(--font-lat);font-size:var(--micro);letter-spacing:.14em;color:var(--muted);direction:ltr}

/* ============ בלוק מותג ============ */
.brand{padding:clamp(70px,11vw,150px) var(--pad)}
.brand-statement{font-size:clamp(26px,4.4vw,58px);font-weight:600;line-height:1.14;letter-spacing:-.01em;max-width:1050px}
.brand-statement .dim{color:var(--muted)}
.brand-cols{display:grid;grid-template-columns:5fr 7fr;gap:clamp(24px,4vw,64px);margin-top:clamp(40px,6vw,80px);align-items:end}
@media(max-width:860px){.brand-cols{grid-template-columns:1fr}}
.brand-cols img{width:100%;aspect-ratio:4/5;object-fit:cover;background:#e9e7e2}
.brand-text p{margin-bottom:14px;max-width:52ch;color:#2e2e2b;font-size:15.5px}
.brand-text .micro{color:var(--muted);display:block;margin-bottom:18px}

/* ============ פס שירות ============ */
.ticker-service{border-top:1px solid var(--warm-line);margin-top:10px}
.ticker-service .ticker__inner{animation-direction:reverse;animation-duration:30s}

/* ============ ניוזלטר ============ */
.news{padding:clamp(70px,10vw,130px) var(--pad);display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,64px)}
@media(max-width:860px){.news{grid-template-columns:1fr}}
.news h2{font-size:clamp(30px,4.6vw,58px);font-weight:600;line-height:1.05;letter-spacing:-.01em}
.news p{color:var(--muted);margin-top:12px;max-width:40ch}
.nform{display:flex;align-items:flex-end;gap:14px;border-bottom:1px solid var(--ink);padding-bottom:10px}
.nform input{flex:1;border:none;background:transparent;font:inherit;font-size:16px;padding:8px 0;outline:none;color:var(--ink)}
.nform input::placeholder{color:var(--muted)}
.nform button{font-size:20px;line-height:1;padding:4px 2px;transition:transform .35s var(--ease)}
.nform button:hover{transform:translateX(-5px)}
.nconsent{margin-top:14px;display:flex;flex-direction:column;gap:7px;font-size:12px;color:var(--muted)}
.nconsent label{display:flex;gap:8px;align-items:flex-start;cursor:pointer}
.nconsent input{margin-top:2px;accent-color:var(--ink)}
.nconsent a{text-decoration:underline;text-underline-offset:2px}
.nok{display:none;margin-top:12px;font-size:13px;font-weight:500}

/* ============ Footer ============ */
footer{border-top:1px solid var(--warm-line);background:var(--warm)}
.fwrap{display:grid;grid-template-columns:1.3fr 1fr 1fr 1.1fr .8fr;gap:26px;padding:clamp(28px,4vw,44px) var(--pad) clamp(18px,2.6vw,28px)}
@media(max-width:960px){.fwrap{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.fwrap{grid-template-columns:1fr}}
.fcol h3{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;margin-bottom:12px;color:#241f19}
.fcol li{margin-bottom:7px;font-size:12.5px;color:var(--warm-ink)}
.fcol a{font-size:12.5px;color:var(--warm-ink)}
.fcol a:hover{text-decoration:underline;text-underline-offset:3px}
.fnews .nform{max-width:300px}
.fnews .nform input{font-size:14px;padding:6px 0}
.fnews .nform button{font-size:17px}
.fnews .nform input::placeholder{color:#7d7060}
.fnote{font-size:11.5px;color:#241f19;margin-top:10px;max-width:300px}
.fbottom{display:flex;justify-content:space-between;gap:12px;padding:12px var(--pad) 16px;font-size:11px;color:#241f19;border-top:1px solid var(--warm-line);flex-wrap:wrap}

/* ============ אוברליי תפריט + עגלה ============ */
.scrim{position:fixed;inset:0;background:rgba(18,18,18,.35);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity .4s;z-index:80}
.scrim.open{opacity:1;pointer-events:auto}
.menu-overlay{position:fixed;inset:0;background:var(--bg);z-index:90;display:flex;flex-direction:column;transform:translateY(-102%);transition:transform .6s var(--ease-io)}
.menu-overlay.open{transform:none}
.mo-head{display:flex;justify-content:space-between;align-items:center;height:52px;padding:0 var(--pad);border-bottom:1px solid var(--line)}
.menu-overlay .mo-head{height:68px;border-bottom:0;flex:none}
.mo-logo img{height:30px;width:auto;display:block}
.mo-x{width:40px;height:40px;display:grid;place-items:center;margin-left:-8px}
.mo-x svg{width:22px;height:22px;fill:none;stroke:var(--ink);stroke-width:1.3;stroke-linecap:round}
.mo-body{flex:1;min-height:0;overflow:hidden;padding:4px 0 8px;display:flex;flex-direction:column}
.mo-body a{display:flex;align-items:center;justify-content:space-between;padding:0 var(--pad);flex:1 1 0;min-height:40px;max-height:60px;font-size:18px;font-weight:500;letter-spacing:.02em;line-height:1;border-bottom:1px solid rgba(46,42,36,.07);opacity:0;transform:translateX(18px);transition:opacity .5s var(--ease),transform .5s var(--ease),background .3s}
.mo-body a:last-child{border-bottom:0}
.mo-body a svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round;opacity:.7}
.mo-body a:hover,.mo-body a:active{background:rgba(46,42,36,.055)}
.mo-body a.on{background:rgba(46,42,36,.055)}
.menu-overlay.open .mo-body a{opacity:1;transform:none}
.mo-foot{padding:16px var(--pad) 22px;background:#e8e4dd;display:flex;flex-direction:column;gap:14px;flex:none}
.mo-foot-row{display:flex;justify-content:space-between;align-items:center;gap:16px}
.mo-region{font-size:14px;font-weight:500;letter-spacing:.02em}
.mo-links{display:flex;gap:18px}
.mo-links a{font-size:13px;letter-spacing:.04em;color:#5a5248}
.mo-social{display:flex;gap:14px}
.mo-social a{width:40px;height:40px;border-radius:50%;border:1px solid rgba(46,42,36,.22);display:grid;place-items:center}
.mo-social img,.mo-social svg{width:17px;height:17px;display:block}
.mo-social svg{fill:none;stroke:var(--ink);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.cart-drawer{position:fixed;top:0;bottom:0;left:0;width:min(440px,100vw);background:var(--bg);z-index:95;transform:translateX(-103%);transition:transform .55s var(--ease-io);display:flex;flex-direction:column;border-inline-end:1px solid var(--line);box-shadow:30px 0 80px -40px rgba(0,0,0,.25)}
.cart-drawer.open{transform:none}
.cd-head{display:flex;justify-content:space-between;align-items:center;padding:0 24px;height:64px;border-bottom:1px solid var(--line);flex:none}
.cd-title{margin:0;font-family:var(--font-he);font-weight:500;font-size:17px;display:flex;align-items:center;gap:10px}
.cd-count{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:11px;background:var(--ink);color:#fff;font-family:var(--font-lat);font-size:11px;font-weight:600}
.cd-x{width:40px;height:40px;display:grid;place-items:center;margin-left:-10px;background:transparent;border:0;cursor:pointer}
.cd-x svg{width:20px;height:20px;fill:none;stroke:var(--ink);stroke-width:1.3;stroke-linecap:round}
.cd-ship{padding:16px 24px 0;flex:none}
.cd-ship p{margin:0 0 10px;font-size:12.5px;color:#5a5248}
.cd-ship p b{font-weight:600;color:var(--ink)}
.cd-ship.done p{color:#2e6b3f}
.cd-bar{height:2px;background:rgba(46,42,36,.12);overflow:hidden}
.cd-bar i{display:block;height:100%;width:0;background:var(--ink);transition:width .8s var(--ease)}
.cd-ship.done .cd-bar i{background:#2e6b3f}
.cart-drawer.empty .cd-ship{display:none}
.cd-body{flex:1;overflow-y:auto;padding:8px 24px 24px}
.cd-item{display:grid;grid-template-columns:84px 1fr;gap:16px;padding:18px 0;border-bottom:1px solid var(--line);opacity:0;transform:translateY(12px);animation:cdIn .6s var(--ease) forwards}
@keyframes cdIn{to{opacity:1;transform:none}}
.cd-item:nth-child(2){animation-delay:.06s}.cd-item:nth-child(3){animation-delay:.12s}.cd-item:nth-child(4){animation-delay:.18s}.cd-item:nth-child(5){animation-delay:.24s}
.cd-item img{width:84px;aspect-ratio:3/4;object-fit:cover;background:#ebe9e4;display:block}
.cd-item .cd-ttl{font-size:14px;font-weight:500;display:block;line-height:1.3}
.cd-item .cd-var{font-size:12px;color:#6f6252;margin-top:4px}
.cd-item .cd-row{display:flex;justify-content:space-between;align-items:center;margin-top:14px;gap:12px}
.cd-qty{display:inline-flex;align-items:center;border:1px solid var(--line);height:32px}
.cd-qty button{width:30px;height:100%;border:0;background:transparent;cursor:pointer;font-size:15px;color:var(--ink)}
.cd-qty span{min-width:24px;text-align:center;font-family:var(--font-lat);font-size:12.5px}
.cd-item .cd-pr{font-family:var(--font-lat);font-size:13.5px;direction:ltr}
.cd-rm{display:inline-block;margin-top:10px;font-size:11.5px;color:#5c5246;text-decoration:underline;text-underline-offset:3px;background:transparent;border:0;cursor:pointer;padding:0;font-family:inherit}
.cd-rm:hover{color:var(--ink)}
.cd-foot{flex:none;padding:16px 24px 22px;border-top:1px solid var(--line);background:var(--bg)}
.cart-drawer.empty .cd-foot{display:none}
/* accessibility statement dialog */
.a11y-modal{position:fixed;inset:0;z-index:120;background:rgba(18,18,18,.45);display:flex;align-items:center;justify-content:center;padding:20px}
.a11y-modal[hidden]{display:none}
.a11y-box{position:relative;background:var(--bg);max-width:620px;width:100%;max-height:85vh;overflow:auto;padding:36px 32px;box-shadow:0 30px 80px -30px rgba(0,0,0,.4)}
.a11y-body h2{font-family:var(--font-he);font-weight:500;font-size:26px;margin:0 0 14px}
.a11y-body h3{font-size:15px;margin:22px 0 8px}
.a11y-body p,.a11y-body li{font-size:14px;line-height:1.7;color:#4a4238}
.a11y-body ul{padding-inline-start:20px}
.a11y-x{position:absolute;top:10px;left:12px;border:0;background:transparent;font-size:28px;line-height:1;cursor:pointer;color:var(--ink)}
/* consent line added by the TNC app: match drawer styling */
#cartDrawer > p:not([class]){margin:0;padding:12px 24px;border-top:1px solid var(--line);background:var(--bg);font-size:12px;line-height:1.55;color:#5a5248}
#cartDrawer > p:not([class]) label{display:flex;gap:8px;align-items:flex-start;width:100%;cursor:pointer;direction:rtl;text-align:right}
#cartDrawer > p:not([class]) input[type=checkbox]{margin:3px 0 0;flex:none;accent-color:var(--ink)}
#cartDrawer > p:not([class]) a{text-decoration:underline;text-underline-offset:3px;color:var(--ink)}
.cd-sub{display:flex;justify-content:space-between;align-items:baseline;font-size:14px;font-weight:500}
.cd-sub span:last-child{font-family:var(--font-lat);font-size:16px;direction:ltr}
.cd-lines{display:flex;flex-direction:column;gap:6px;margin-bottom:10px}
.cd-line{display:flex;justify-content:space-between;font-size:12.5px;color:#5a5248}
.cd-line span:last-child{font-family:var(--font-lat);direction:ltr}
.cd-sub{border-top:1px solid var(--line);padding-top:10px}
.cd-note{margin:6px 0 10px;font-size:11.5px;color:#5c5246}
.cd-note a{text-decoration:underline;text-underline-offset:3px;color:#5a5248}
.cd-memo{margin-bottom:14px}
.cd-memo summary{list-style:none;cursor:pointer;font-size:12.5px;color:#5a5248;text-decoration:underline;text-underline-offset:3px;display:inline-block}
.cd-memo summary::-webkit-details-marker{display:none}
.cd-memo textarea{display:block;width:100%;margin-top:10px;border:1px solid var(--line);background:#fff;font:inherit;font-size:13px;padding:10px 12px;resize:vertical;min-height:70px;outline:none;color:var(--ink)}
.cd-memo textarea:focus{border-color:var(--ink)}
.cd-go{display:flex;align-items:center;justify-content:space-between;height:56px;padding:0 22px;background:var(--ink);color:#fff;font-size:13px;letter-spacing:.12em;text-transform:uppercase;transition:background .3s,transform .3s var(--ease)}
.cd-go:hover{background:#000}
.cd-go span:last-child{font-family:var(--font-lat);font-size:14px;letter-spacing:0;direction:ltr}
.cd-more{display:block;text-align:center;margin-top:12px;font-size:12.5px;color:#5a5248;text-decoration:underline;text-underline-offset:3px}
.cd-empty{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;padding:30px 0}
.cd-empty svg{width:46px;height:46px;fill:none;stroke:var(--ink);stroke-width:1;stroke-linecap:round;stroke-linejoin:round;opacity:.8}
.cd-empty h4{margin:6px 0 0;font-family:var(--font-he);font-weight:500;font-size:20px}
.cd-empty p{margin:0;font-size:13.5px;color:#6f6252;max-width:26ch}
.cd-empty .btn-line{margin-top:10px}
.cd-sugg{margin-top:28px;width:100%}
.cd-sugg h5{margin:0 0 12px;font-family:var(--font-lat);font-size:10.5px;letter-spacing:.3em;text-transform:uppercase;color:#6f6252;font-weight:600}
.cd-sugg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.cd-sugg-grid a{display:block;text-align:right}
.cd-sugg-grid .im{aspect-ratio:3/4;background:#ebe9e4;overflow:hidden}
.cd-sugg-grid img{width:100%;height:100%;object-fit:cover;display:block}
.cd-sugg-grid .t{display:block;font-size:11.5px;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cd-sugg-grid .pr{display:block;font-family:var(--font-lat);font-size:11px;color:#6f6252;direction:ltr;text-align:right}
.hic{position:relative}
.hic-dot{position:absolute;top:7px;right:5px;width:7px;height:7px;border-radius:50%;background:#2e6b3f;transform:scale(0);transition:transform .35s var(--ease)}
body.logged .hic-dot{transform:none}
.ac-body{flex:1;overflow-y:auto;padding:26px 28px 34px}
.ac-tabs{display:flex;position:relative;border-bottom:1px solid var(--line);margin-bottom:26px}
.ac-tabs button{flex:1;height:44px;background:transparent;border:0;font:inherit;font-size:14px;color:#8a7e6f;cursor:pointer;transition:color .3s}
.ac-tabs button.on{color:var(--ink);font-weight:500}
.ac-tabs i{position:absolute;bottom:-1px;height:1.5px;width:50%;background:var(--ink);right:0;transition:transform .4s var(--ease)}
.ac-tabs.alt i{transform:translateX(-100%)}
.ac-intro{font-size:13.5px;color:#5a5248;line-height:1.6;margin:0 0 22px}
.ac-f{display:flex;flex-direction:column;gap:16px}
.ac-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ac-field{position:relative}
.ac-field input{width:100%;height:50px;border:0;border-bottom:1px solid #c9c4bb;background:transparent;font:inherit;font-size:15px;color:var(--ink);padding:14px 0 0;outline:none;transition:border-color .3s}
.ac-field input:focus{border-color:var(--ink)}
.ac-field label{position:absolute;right:0;top:16px;font-size:14px;color:#8a7e6f;pointer-events:none;transition:all .25s var(--ease);transform-origin:right top}
.ac-field input:focus + label,.ac-field input:not(:placeholder-shown) + label{top:0;font-size:11px;color:#6f6252}
.ac-field input::placeholder{color:transparent}
.ac-field.lat input{direction:ltr;text-align:left}
.ac-eye{position:absolute;left:0;top:14px;width:30px;height:30px;display:grid;place-items:center;background:transparent;border:0;cursor:pointer;color:#8a7e6f}
.ac-eye svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.ac-field.err input{border-color:#b4452f}
.ac-msg{font-size:12px;color:#b4452f;min-height:16px;margin-top:-6px}
.ac-between{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:#5a5248;margin-top:-4px}
.ac-check{display:flex;align-items:center;gap:10px;cursor:pointer}
.ac-check input{width:16px;height:16px;accent-color:var(--ink);margin:0}
.ac-link{background:transparent;border:0;font:inherit;font-size:12.5px;color:#5a5248;text-decoration:underline;text-underline-offset:3px;cursor:pointer;padding:0}
.ac-link:hover{color:var(--ink)}
.ac-btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:54px;margin-top:6px;border:0;background:var(--ink);color:#fff;font:inherit;font-size:13px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:background .3s,opacity .3s}
.ac-btn:hover{background:#000}.ac-btn:disabled{opacity:.6;cursor:wait}
.ac-btn .sp{width:14px;height:14px;border:1.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:acSpin .8s linear infinite;display:none}
.ac-btn.busy .sp{display:block}
@keyframes acSpin{to{transform:rotate(360deg)}}
.ac-or{display:flex;align-items:center;gap:14px;margin:24px 0 16px;font-size:11.5px;color:#8a7e6f;letter-spacing:.1em}
.ac-or::before,.ac-or::after{content:'';flex:1;height:1px;background:var(--line)}
.ac-soc{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.ac-soc button{height:46px;border:1px solid #c9c4bb;background:transparent;font:inherit;font-size:13px;display:flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;color:var(--ink);transition:border-color .3s,background .3s}
.ac-soc button:hover{border-color:var(--ink);background:rgba(46,42,36,.03)}
.ac-soc svg{width:16px;height:16px}
.ac-foot{margin-top:26px;font-size:11.5px;color:#8a7e6f;line-height:1.6}
.ac-foot a{text-decoration:underline;text-underline-offset:3px}
.ac-hello{margin:6px 0 4px;font-family:var(--font-he);font-weight:600;font-size:clamp(28px,3vw,34px);line-height:1.05;letter-spacing:-.01em}
.ac-sub{font-size:13.5px;color:#6f6252;margin:0 0 26px}
.ac-club{background:var(--ink);color:#fff;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:22px}
.ac-club b{display:block;font-family:var(--font-lat);font-size:10.5px;letter-spacing:.3em;text-transform:uppercase;opacity:.7;margin-bottom:6px;font-weight:600}
.ac-club span{font-size:14px}
.ac-club .pts{font-family:var(--font-lat);font-size:26px;font-weight:600;direction:ltr}
.ac-menu{border-top:1px solid var(--line)}
.ac-menu a,.ac-menu button{display:flex;justify-content:space-between;align-items:center;width:100%;padding:17px 0;border:0;border-bottom:1px solid var(--line);background:transparent;font:inherit;font-size:14.5px;color:var(--ink);cursor:pointer;text-align:right}
.ac-menu svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round;opacity:.7}
.ac-menu small{font-size:11.5px;color:#8a7e6f;margin-right:auto;margin-left:10px}
.ac-out{margin-top:22px;font-size:12.5px}
.ac-ok{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:30px 0}
.ac-ok svg{width:44px;height:44px;fill:none;stroke:#2e6b3f;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round}
.ac-ok h4{margin:0;font-family:var(--font-he);font-weight:500;font-size:20px}
.ac-ok p{margin:0;font-size:13.5px;color:#6f6252;max-width:30ch}
.ac-view{animation:cdIn .5s var(--ease) both}
.hic-badge{position:absolute;top:2px;right:0;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:var(--ink);color:#fff;font-family:var(--font-lat);font-size:9.5px;font-weight:600;display:grid;place-items:center;transform:scale(0);transition:transform .35s var(--ease)}
.hic-badge.on{transform:none}
header.scrolled .hic-badge,.sub .hic-badge{background:var(--ink)}
.btn-line{font-size:12.5px;letter-spacing:.06em;border:1px solid var(--ink);padding:12px 26px;transition:background .3s,color .3s}
.btn-line:hover{background:var(--ink);color:var(--bg)}

/* ===== אודות ===== */
.about-overlay{position:fixed;inset:0;background:var(--bg);z-index:90;transform:translateY(103%);transition:transform .6s var(--ease-io);display:flex;flex-direction:column;overflow:hidden}
.about-overlay:not(.open) .mo-head{visibility:hidden}
.about-overlay.open{transform:none}
.about-body{flex:1;overflow-y:auto;display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,64px);padding:clamp(24px,4vw,56px) var(--pad);align-items:center}
@media(max-width:860px){.about-body{grid-template-columns:1fr;align-items:start}}
.about-text .micro{color:var(--muted);display:block;margin-bottom:18px}
.about-statement{font-size:clamp(24px,3.4vw,44px);font-weight:600;line-height:1.15;letter-spacing:-.01em;margin-bottom:22px}
.about-text p{margin-bottom:14px;color:#2e2e2b;font-size:15.5px;max-width:52ch}
.about-media{position:relative;overflow:hidden;background:#d9d6d0}
.ab-x{display:none;position:absolute;top:14px;left:14px;z-index:5;width:40px;height:40px;border-radius:50%;background:rgba(244,241,236,.82);backdrop-filter:blur(8px);place-items:center;transition:opacity .3s,transform .3s var(--ease)}
.ab-x svg{width:18px;height:18px;fill:none;stroke:var(--ink);stroke-width:1.4;stroke-linecap:round}
.about-video{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;background:#d9d6d0;transform:scale(1.04);transition:transform 1.8s var(--ease)}
.about-overlay.open .about-video{transform:none}
.ab-tag{text-shadow:0 1px 6px rgba(0,0,0,.55);position:absolute;left:14px;bottom:12px;font-family:var(--font-lat);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#fff;opacity:.85;direction:ltr}
.ab-kick{display:flex;align-items:center;gap:12px;font-family:var(--font-lat);font-size:10.5px;letter-spacing:.38em;text-transform:uppercase;font-weight:600;color:var(--muted);direction:ltr;justify-content:flex-end}
.ab-kick i{display:block;width:26px;height:1px;background:currentColor}
.ab-title{margin:22px 0 22px;font-family:var(--font-he);font-weight:600;font-size:clamp(44px,5.6vw,84px);line-height:.98;letter-spacing:-.02em}
.ab-title em{font-style:normal;color:transparent;-webkit-text-stroke:1.5px var(--ink)}
.ab-lead{font-size:clamp(17px,1.35vw,21px);font-weight:500;line-height:1.5;color:var(--ink);max-width:48ch;margin-bottom:14px}
