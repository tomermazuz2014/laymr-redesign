let carIdx = CAR_N; /* הפריט הראשון בעותק האמצעי - האחרון נראה משמאלו */
function carPlace(i, instant){
  if (instant) carTrack.classList.add('noanim');
  carItems.forEach((el, n) => el.classList.toggle('is-center', n === i));
  const el = carItems[i];
  const wrap = carTrack.parentElement;
  const off = el.offsetLeft - (wrap.clientWidth - el.offsetWidth) / 2;
  carTrack.style.transform = 'translateX(' + (-off) + 'px)';
  if (instant){ carTrack.getBoundingClientRect(); carTrack.classList.remove('noanim'); }
  document.getElementById('pcarCount').textContent =
    String((i % CAR_N) + 1).padStart(2,'0') + ' / ' + String(CAR_N).padStart(2,'0');
}
let carSnap = 0;
function carGo(i){
  carIdx = Math.max(1, Math.min(i, CAR_N * 3 - 2));
  carPlace(carIdx, false);
  clearTimeout(carSnap);
  carSnap = setTimeout(() => {
    if (carIdx < CAR_N){ carIdx += CAR_N; carPlace(carIdx, true); }
    else if (carIdx >= CAR_N * 2){ carIdx -= CAR_N; carPlace(carIdx, true); }
  }, 720);
}
