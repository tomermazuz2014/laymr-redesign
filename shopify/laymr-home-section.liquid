(() => {
  const box = carTrack.parentElement;
  let sx = 0, sy = 0, tracking = false;
  box.addEventListener('pointerdown', e => { if (e.pointerType === 'mouse') return; sx = e.clientX; sy = e.clientY; tracking = true; }, {passive:true});
  let swipedAt = 0;
  box.addEventListener('pointerup', e => {
    if (!tracking) return; tracking = false;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
    swipedAt = Date.now();
    carGo(carIdx + (dx < 0 ? 1 : -1));
  }, {passive:true});
  /* החלקה שהסתיימה מעל כרטיס לא פותחת את קישור המוצר */
  box.addEventListener('click', e => { if (Date.now() - swipedAt < 600){ e.preventDefault(); e.stopPropagation(); } }, true);
  box.addEventListener('pointercancel', () => { tracking = false; }, {passive:true});
})();
