  } else {
    ['touchstart','scroll','click','keydown'].forEach(ev => addEventListener(ev, kickVideos, {once:true, passive:true}));
    const p0 = hv.play();
    if (p0 && p0.catch) p0.catch(() => { setTimeout(() => { if (hv.paused && !heroEl.classList.contains('sale-on') && !heroEl.classList.contains('rep-on')) showSale(); }, 9000); });
  }
}

