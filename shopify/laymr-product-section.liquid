</aside>

<script>
(function(){
  const $ = s => document.querySelector(s);
  const NAV = [
  {t:'חדש', u:'/collections/%D7%A7%D7%99%D7%A5-new'},
  {t:'מכופתרות', u:'/collections/%D7%A7%D7%95%D7%9C%D7%A7%D7%A6%D7%99%D7%99%D7%AA-%D7%97%D7%92'},
  {t:'מכנסיים', u:'/collections/%D7%A7%D7%A4%D7%95%D7%A6%D7%95%D7%A0%D7%99%D7%9D'},
  {t:'חולצות', u:'/collections/%D7%97%D7%95%D7%9C%D7%A6%D7%95%D7%AA'},
  {t:'אקססוריז', u:'/collections/%D7%92%D7%95%D7%A4%D7%99%D7%95%D7%AA'},
  {t:'חליפות', u:'/collections/%D7%97%D7%9C%D7%99%D7%A4%D7%95%D7%AA'},
  {t:'ספורט', u:'/collections/%D7%A1%D7%A4%D7%95%D7%A8%D7%98'},
  {t:'Outlet', u:'/collections/%D7%A7%D7%95%D7%9C%D7%A7%D7%A6%D7%99%D7%99%D7%AA-%D7%A7%D7%99%D7%A5'},
  {t:'בגדי ים', u:'/collections/%D7%91%D7%92%D7%93%D7%99-%D7%99%D7%9D'}
];
  $('#hnav').innerHTML = NAV.map(n => '<a href="' + n.u + '">' + n.t + '</a>').join('') + '<a href="#about" data-about>אודות</a>';
  const moChev = '<svg viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"/></svg>';
  $('#moLinks').innerHTML = NAV.map((n,i) => '<a href="' + n.u + '" style="transition-delay:' + (0.06 + i*0.04) + 's"><span>' + n.t + '</span>' + moChev + '</a>').join('') + '<a href="#about" data-about style="transition-delay:.46s"><span>אודות</span>' + moChev + '</a>';
  $('#fshop').innerHTML = NAV.map(n => '<li><a href="' + n.u + '">' + n.t + '</a></li>').join('');
  const scrim = $('#scrim'), menuOverlay = $('#menuOverlay'), cartDrawer = $('#cartDrawer'), acctDrawer = $('#acctDrawer'), aboutOverlay = $('#aboutOverlay');
  function closeAll(){ scrim.classList.remove('open'); menuOverlay.classList.remove('open'); cartDrawer.classList.remove('open'); acctDrawer.classList.remove('open'); aboutOverlay.classList.remove('open'); }
  $('#menuOpen').onclick = () => { menuOverlay.classList.add('open'); scrim.classList.add('open'); };
  $('#menuClose').onclick = closeAll;
  $('#cartOpen').onclick = () => { scrim.classList.add('open'); cartDrawer.classList.add('open'); loadCart(); };
  $('#cartClose').onclick = closeAll;
  const openAbout = () => { closeAll(); aboutOverlay.classList.add('open'); };
  document.querySelectorAll('[data-about]').forEach(a => a.addEventListener('click', e => { e.preventDefault(); openAbout(); }));
  $('#aboutClose').onclick = closeAll; $('#aboutX').onclick = closeAll;
  scrim.addEventListener('click', closeAll);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
  const hdrEl = document.querySelector('header'); const onS = () => hdrEl.classList.toggle('scrolled', scrollY > 8); onS(); addEventListener('scroll', onS, {passive: true});

  /* Shopify cart drawer (cart.js API) */
  const money = v => '₪' + (Number(v) / 100).toLocaleString('he-IL', {maximumFractionDigits: 2}).replace(/\.00$/, '');
  const esc = t => String(t == null ? '' : t).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const cartCall = async (url, body) => (await fetch(url, {method: body ? 'POST' : 'GET', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: body ? JSON.stringify(body) : undefined})).json();
  function renderCart(c){
    $('#cdCount').textContent = c.item_count;
    const body = $('#cdBody'), foot = $('#cdFoot');
    if (!c.items.length){ body.innerHTML = '<div class="cd-empty"><h4>העגלה שלך ריקה</h4><p>הפריטים שתוסיפו יופיעו כאן.</p><a class="btn-line" href="/collections/all">המשך בקנייה</a></div>'; foot.innerHTML = ''; return; }
    body.innerHTML = c.items.map(it => '<div class="cd-item"><a href="' + esc(it.url) + '"><img src="' + esc(it.image) + '" alt=""></a><div><a class="cd-ttl" href="' + esc(it.url) + '">' + esc(it.product_title) + '</a>' + (it.variant_title && it.variant_title !== 'Default Title' ? '<div class="cd-var">' + esc(it.variant_title) + '</div>' : '') +
      '<div class="cd-row"><div class="cd-qty"><button data-k="' + esc(it.key) + '" data-q="' + (it.quantity + 1) + '" aria-label="יותר">+</button><span>' + it.quantity + '</span><button data-k="' + esc(it.key) + '" data-q="' + (it.quantity - 1) + '" aria-label="פחות">−</button></div><span class="cd-pr">' + money(it.final_line_price) + '</span></div>' +
      '<button class="cd-rm" data-k="' + esc(it.key) + '" data-q="0">הסרה</button></div></div>').join('');
    foot.innerHTML = '<div class="cd-sub"><span>סה"כ</span><span>' + money(c.total_price) + '</span></div><a class="cd-go" href="/checkout"><span>לתשלום</span><span>' + money(c.total_price) + '</span></a><a class="cd-more" href="/collections/all">המשך בקנייה</a>';
    body.querySelectorAll('button[data-k]').forEach(b => b.onclick = async () => renderCart(await cartCall('/cart/change.js', {id: b.dataset.k, quantity: Math.max(0, +b.dataset.q)})));
  }
  const loadCart = async () => { try { renderCart(await cartCall('/cart.js')); } catch (e) {} };
  document.addEventListener('cart:updated', loadCart);
  loadCart();
  const nf = $('#newsForm'); if (nf) nf.addEventListener('submit', e => { e.preventDefault(); $('#newsOk').style.display = 'block'; });
})();
</script>

<script>
(function(){
  const P = {
    title: {{ product.title | json }},
    handle: {{ product.handle | json }},
    body: {{ product.description | json }},
    options: {{ product.options_with_values | json }},
    images: [{% for img in product.images %}{id: {{ img.id }}, src: {{ img | image_url: width: 1000 | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
    variants: [{% for v in product.variants %}{id: {{ v.id }}, title: {{ v.title | json }}, o1: {{ v.option1 | json }}, o2: {{ v.option2 | json }}, o3: {{ v.option3 | json }}, price: {{ v.price | divided_by: 100.0 }}, cmp: {{ v.compare_at_price | default: 0 | divided_by: 100.0 }}, avail: {{ v.available }}, img: {% if v.image %}{{ v.image.id }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  };
  const $ = s => document.querySelector(s);
  const price = v => '₪' + Number(v).toLocaleString('he-IL', {maximumFractionDigits: 2}).replace(/\.00$/, '');
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const COLORS = {'שחור':'#141414','לבן':'#ffffff','אפור':'#9a9a9a','אבן':'#cfc6b8','ג׳ינס':'#5b7aa6'};
  const isColor = o => /צבע|color/i.test(o.name), isSize = o => /מידה|size/i.test(o.name);
  document.title = P.title + ' — LAYMR';
  $('#crumb').textContent = P.title; $('#ptitle').textContent = P.title;

  /* gallery */
  const imgs = P.images.length ? P.images : [{id: 0, src: ''}];
  const track = $('#galTrack'), dots = $('#galDots'), gal = document.querySelector('.pdp-gal'); let cur = 0;
  track.innerHTML = imgs.map((im, i) => '<div class="pdp-slide"><img class="main" ' + (i ? 'loading="lazy" ' : '') + 'src="' + im.src + '" alt="' + esc(P.title) + '"></div>').join('');
  dots.innerHTML = imgs.map((_, i) => '<i class="' + (i ? '' : 'on') + '"></i>').join('');
  if (imgs.length < 2) gal.classList.add('single');
  const goTo = i => { cur = (i + imgs.length) % imgs.length; track.scrollTo({left: cur * track.clientWidth, behavior: 'smooth'}); };
  track.addEventListener('scroll', () => { const i = Math.round(track.scrollLeft / track.clientWidth); if (i !== cur){ cur = i; dots.querySelectorAll('i').forEach((d, n) => d.classList.toggle('on', n === i)); } }, {passive: true});
  $('#galNext').onclick = () => goTo(cur + 1); $('#galPrev').onclick = () => goTo(cur - 1);
  dots.querySelectorAll('i').forEach((d, i) => d.onclick = () => goTo(i));
  $('#saveBtn').onclick = e => e.currentTarget.classList.toggle('on');

  /* options */
  const realOpts = P.options.filter(o => !(o.values.length === 1 && o.values[0] === 'Default Title'));
  const firstAvail = P.variants.find(v => v.avail) || P.variants[0];
  const sel = {};
  realOpts.forEach((o, i) => { sel[i] = firstAvail ? ([firstAvail.o1, firstAvail.o2, firstAvail.o3][i] || o.values[0]) : o.values[0]; });
  const optsEl = $('#opts');
  const variantFor = () => P.variants.find(v => realOpts.every((o, i) => [v.o1, v.o2, v.o3][i] === sel[i])) || P.variants[0];
  const availFor = (i, val) => P.variants.some(v => [v.o1, v.o2, v.o3][i] === val && v.avail);
  const dot = c => '<i style="background:' + (COLORS[String(c).trim()] || '#bdb5aa') + '"></i>';
  const drawOpts = () => {
    optsEl.innerHTML = realOpts.map((o, i) => {
      if (isColor(o)) return '<div class="pdp-row" data-i="' + i + '"><span class="lbl">בחירת צבע</span><button class="pdp-cur" type="button">' + dot(sel[i]) + esc(sel[i]) + '<svg viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"/></svg></button><div class="pdp-list">' +
        o.values.map(v => '<button type="button" data-i="' + i + '" data-v="' + esc(v) + '" class="' + (sel[i] === v ? 'on' : '') + (availFor(i, v) ? '' : ' off') + '">' + dot(v) + esc(v) + '</button>').join('') + '</div></div>';
      return '<div class="pdp-size"><span class="lbl">' + (isSize(o) ? 'בחירת מידה:' : esc(o.name) + ':') + '</span><div class="pdp-chips">' +
        o.values.map(v => '<button type="button" data-i="' + i + '" data-v="' + esc(v) + '" class="' + (sel[i] === v ? 'on' : '') + (availFor(i, v) ? '' : ' off') + '">' + esc(v) + '</button>').join('') + '</div></div>';
    }).join('');
    optsEl.querySelectorAll('.pdp-cur').forEach(b => b.onclick = () => b.parentElement.classList.toggle('open'));
    optsEl.querySelectorAll('button[data-v]').forEach(b => b.onclick = () => { sel[+b.dataset.i] = b.dataset.v; drawOpts(); drawPrice(); });
  };

  /* price + gallery sync by variant image */
  const priceEl = $('#pprice'), addBtn = $('#addBtn');
  const drawPrice = () => { const v = variantFor(); const sale = v.cmp && Number(v.cmp) > Number(v.price);
    priceEl.className = 'pdp-price' + (sale ? ' sale' : '');
    priceEl.innerHTML = (sale ? '<span class="pct">-' + Math.round((1 - Number(v.price) / Number(v.cmp)) * 100) + '%</span><s>' + price(v.cmp) + '</s>' : '') + '<span class="now">' + price(v.price) + '</span>';
    addBtn.disabled = !v.avail; addBtn.textContent = v.avail ? 'הוספה לסל' : 'אזל מהמלאי';
    if (v.img){ const k = imgs.findIndex(im => im.id === v.img); if (k >= 0 && k !== cur) goTo(k); } };
  drawOpts(); drawPrice();

  /* add to cart (Shopify Cart AJAX API) */
  addBtn.onclick = async () => {
    const v = variantFor(); if (!v.avail) return;
    addBtn.disabled = true; addBtn.textContent = 'מוסיף...';
    try {
      const r = await fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: JSON.stringify({items: [{id: v.id, quantity: 1}]})});
      if (!r.ok) throw new Error(await r.text());
      addBtn.textContent = 'נוסף לסל ✓';
      document.dispatchEvent(new CustomEvent('cart:updated')); document.getElementById('cartOpen').click();
    } catch (e) { addBtn.textContent = 'שגיאה, נסה שוב'; }
    setTimeout(() => { addBtn.disabled = false; drawPrice(); }, 1400);
  };

  $('#pdesc').innerHTML = P.body || '<p>פריט מקולקציית LAYMR.</p>';
})();
</script>

{% schema %}
{
  "name": "LAYMR Product",
  "settings": []
}
{% endschema %}
