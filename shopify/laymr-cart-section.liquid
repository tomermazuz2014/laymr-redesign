<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Sans+Hebrew:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://tomermazuz2014.github.io/laymr-redesign/assets/base.css">
<link rel="stylesheet" href="https://tomermazuz2014.github.io/laymr-redesign/assets/pages.css">
<style>
body,h1,h2,h3,h4,h5,h6,p,a,span,li,button,input,select,textarea,label{font-family:'Ploni',sans-serif !important}
</style>

<header>
  <div class="header-row">
    <div class="h-start">
      <button class="menu-toggle" id="menuOpen" aria-label="תפריט" aria-expanded="false"><svg viewBox="0 0 24 24"><path class="l1" d="M3 6h18"/><path class="l2" d="M3 12h18"/><path class="l3" d="M3 18h18"/></svg></button>
      <nav class="h-nav" id="hnav" aria-label="ניווט ראשי"></nav>
    </div>
    <a class="h-mark" href="#"><span class="h-mark-text">LAYMR</span><img class="h-mark-logo" src="https://tomermazuz2014.github.io/laymr-redesign/images/logo-lm.png" alt="LAYMR"></a>
    <div class="h-util">
      <a class="hic" href="/search" aria-label="חיפוש"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
      <button class="hic" id="acctOpen" aria-label="חשבון"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg><span class="hic-dot"></span></button>
      <button class="hic" id="cartOpen" aria-label="עגלה"><svg viewBox="0 0 24 24"><path d="M6 8h12l1 13H5L6 8Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg></button>
    </div>
  </div>
</header>
<main class="pg cart" dir="rtl">
<div class="cart-page">
  <h1 class="cart-h">העגלה שלך</h1>
  {% if cart.item_count == 0 %}
    <div class="cd-empty"><h4>העגלה שלך ריקה</h4><p>הפריטים שתוסיפו יופיעו כאן.</p><a class="btn-line" href="/collections/all">המשך בקנייה</a></div>
  {% else %}
    <div class="cart-lines">
    {% for item in cart.items %}
      <div class="cd-item cart-line">
        <a href="{{ item.url }}"><img src="{{ item.image | img_url: '300x' }}" alt="{{ item.product.title | escape }}"></a>
        <div>
          <a class="cd-ttl" href="{{ item.url }}">{{ item.product.title | escape }}</a>
          {% unless item.variant.title == 'Default Title' %}<div class="cd-var">{{ item.variant.title | escape }}</div>{% endunless %}
          <div class="cd-row">
            <div class="cd-qty"><button data-k="{{ item.key }}" data-q="{{ item.quantity | plus: 1 }}" aria-label="יותר">+</button><span>{{ item.quantity }}</span><button data-k="{{ item.key }}" data-q="{{ item.quantity | minus: 1 }}" aria-label="פחות">−</button></div>
            <span class="cd-pr">₪{{ item.final_line_price | divided_by: 100 }}</span>
          </div>
          <button class="cd-rm" data-k="{{ item.key }}" data-q="0">הסרה</button>
        </div>
      </div>
    {% endfor %}
    </div>
    <div class="cart-sum">
      <div class="cd-sub"><span>סה"כ</span><span>₪{{ cart.total_price | divided_by: 100 }}</span></div>
      <a class="cd-go" href="/checkout"><span>לתשלום</span><span>₪{{ cart.total_price | divided_by: 100 }}</span></a>
      <a class="cd-more" href="/collections/all">המשך בקנייה</a>
    </div>
  {% endif %}
</div>
</main>
<footer>
  <div class="ft-top" data-reveal>
    <div class="ft-cta">
      <img class="ft-cta-mark" src="https://tomermazuz2014.github.io/laymr-redesign/images/logo-lm.png" alt="LAYMR">
      <span class="ft-kick"><i></i>Newsletter</span>
      <h3 class="ft-h">הצטרפו למועדון <em>LAYMR</em></h3>
