          <li><a href="/policies/terms-of-service">תקנון ותנאי שימוש</a></li>
          <li><a href="#">הצהרת נגישות</a></li>
          <li><a href="#">ביטול עסקה</a></li>
        </ul>
      </div>
      <div class="fcol">
        <h3>Service</h3>
        <ul>
          <li>מענה טלפוני: ב'-ה', 09:00-16:00</li>
          <li><a href="https://wa.me/972505506008">וואטסאפ: 0505506008</a></li>
          <li><a href="mailto:laymr@eyal-golan.co.il">laymr@eyal-golan.co.il</a></li>
        </ul>
        <div class="ft-giant" aria-hidden="true">LAYMR</div>
      </div>
    </div>
  </div>
  <div class="ft-mid">
    <div class="ft-social">
      <a class="ft-soc" href="https://www.instagram.com/laymr.official/" target="_blank" rel="noopener" aria-label="Instagram"><img src="https://tomermazuz2014.github.io/laymr-redesign/images/icons/icon-instagram.svg" alt="" width="18" height="18"></a>
      <a class="ft-soc" href="https://wa.me/972505506008" target="_blank" rel="noopener" aria-label="WhatsApp"><img src="https://tomermazuz2014.github.io/laymr-redesign/images/icons/icon-whatsapp.svg" alt="" width="18" height="18"></a>
      <a class="ft-soc" href="mailto:laymr@eyal-golan.co.il" aria-label="אימייל"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
    </div>
    <a class="ft-up" href="#"><span>חזרה למעלה</span><svg viewBox="0 0 24 24"><path d="M12 19V5"/><path d="m6 11 6-6 6 6"/></svg></a>
  </div>
  <div class="fbottom">
    <span>© 2026 LAYMR</span>
    <span>כל הזכויות שמורות</span>
  </div>
</footer>

<!-- תפריט מלא -->
<div class="menu-overlay" id="menuOverlay" aria-label="תפריט">
  <div class="mo-head">
    <a class="mo-logo" href="/" aria-label="LAYMR"><img src="https://tomermazuz2014.github.io/laymr-redesign/images/logo-lm.png" alt="LAYMR"></a>
    <button id="menuClose" class="mo-x" aria-label="סגירה"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
