      <a href="mailto:laymr@eyal-golan.co.il" aria-label="אימייל"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
    </div>
  </div>
</div>

<!-- עגלה -->
<!-- אודות -->
<div class="about-overlay" id="aboutOverlay" aria-label="אודות">
  <div class="mo-head">
    <span class="micro-he">אודות</span>
    <button id="aboutClose" class="micro-he">סגירה</button>
  </div>
  <button class="ab-x" id="aboutX" aria-label="סגירה"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <div class="about-body">
    <div class="about-text">
      <span class="ab-kick"><i></i>About — LAYMR by Eyal Golan</span>
      <h2 class="ab-title">אופנה<br>עם <em>זהות.</em></h2>
      <p class="ab-lead">LAYMR הוא מותג האופנה של אייל גולן — פריטים ואקססוריז שמביאים סגנון אישי וייחודי לכל אחד, עם איכות גבוהה ומחירים נגישים.</p>
      <p class="ab-p">המותג מציע מגוון פריטים המשלבים עיצוב מודרני עם אלמנטים המייצגים את זהותו האישית של אייל — גזרות נוחות, בדים נעימים ופרטים קטנים שעושים את ההבדל.</p>
      <p class="ab-p">אנחנו שואפים לייצר חווית קנייה ייחודית, שמחברת בין עולם האופנה לאנשים שלובשים אותו — פריטים מותאמים לכל גיל ולכל סגנון, מהבמה ועד הרחוב.</p>
      <ul class="ab-vals">
        <li><b>01</b><span>עיצוב ישראלי</span></li>
        <li><b>02</b><span>איכות ללא פשרות</span></li>
        <li><b>03</b><span>מחיר נגיש לכולם</span></li>
        <li><b>04</b><span>שירות אישי</span></li>
      </ul>
      <div class="ab-ctas">
        <a class="ab-btn" href="/collections/%D7%A7%D7%99%D7%A5-new">לקולקציה החדשה<svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m11 6-6 6 6 6"/></svg></a>
        <a class="ab-link" href="https://www.instagram.com/laymr.official/" target="_blank" rel="noopener">Instagram</a>
      </div>
      <div class="ab-sign" aria-hidden="true">LAYMR</div>
    </div>
    <div class="about-media">
      <video class="about-video" muted loop playsinline preload="none" poster="https://tomermazuz2014.github.io/laymr-redesign/images/about-poster.jpg" data-msrc="https://tomermazuz2014.github.io/laymr-redesign/media/about-m.mp4" data-mposter="https://tomermazuz2014.github.io/laymr-redesign/images/about-m-poster.jpg" aria-label="LAYMR — אייל גולן"><source src="https://tomermazuz2014.github.io/laymr-redesign/media/about.mp4" type="video/mp4"></video>
      <span class="ab-tag">LAYMR · 2026</span>
    </div>
  </div>
</div>

<div class="scrim" id="scrim"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="עגלת קניות">
  <div class="cd-head">
    <h3 class="cd-title">העגלה שלך <span class="cd-count" id="cdCount">0</span></h3>
    <button id="cartClose" class="cd-x" aria-label="סגירה"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="cd-ship" id="cdShip"><p></p><div class="cd-bar"><i></i></div></div>
  <div class="cd-body" id="cdBody"></div>
  <div class="cd-foot" id="cdFoot"></div>
</aside>

<aside class="acct-drawer" id="acctDrawer" aria-label="חשבון">
  <div class="cd-head">
    <h3 class="cd-title" id="acctTitle">החשבון שלי</h3>
    <button id="acctClose" class="cd-x" aria-label="סגירה"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="ac-body" id="acctBody"></div>
</aside>
<script>
(function(){
  const $ = s => document.querySelector(s);
  const NAV = [
  {t:'חדש', u:'/collections/%D7%A7%D7%99%D7%A5-new'},
  {t:'מכופתרות', u:'/collections/%D7%A7%D7%95%D7%9C%D7%A7%D7%A6%D7%99%D7%99%D7%AA-%D7%97%D7%92'},
  {t:'מכנסיים', u:'/collections/%D7%A7%D7%A4%D7%95%D7%A6%D7%95%D7%A0%D7%99%D7%9D'},
  {t:'חולצות', u:'/collections/%D7%97%D7%95%D7%9C%D7%A6%D7%95%D7%AA'},
  {t:'אקססוריז', u:'/collections/%D7%92%D7%95%D7%A4%D7%99%D7%95%D7%AA'},
  {t:'חליפות', u:'/collections/%D7%97%D7%9C%D7%99%D7%A4%D7%95%D7%AA'},
  {t:'ספורט', u:'/collections/%D7%A1%D7%A4%D7%95%D7%A8%D7%98'},
  {t:'Outlet', u:'/collections/%D7%A7%D7%95%D7%9C%D7%A7%D7%A6%D7%99%D7%99%D7%AA-%D7%A7%D7%99%D7%A5'},
  {t:'בגדי ים', u:'/collections/%D7%91%D7%92%D7%93%D7%99-%D7%99%D7%9D'}
];
  $('#hnav').innerHTML = NAV.map(n => '<a href="' + n.u + '">' + n.t + '</a>').join('') + '<a href="#about" data-about>אודות</a>';
  const moChev = '<svg viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"/></svg>';
  $('#moLinks').innerHTML = NAV.map((n,i) => '<a href="' + n.u + '" style="transition-delay:' + (0.06 + i*0.04) + 's"><span>' + n.t + '</span>' + moChev + '</a>').join('') + '<a href="#about" data-about style="transition-delay:.46s"><span>אודות</span>' + moChev + '</a>';
  $('#fshop').innerHTML = NAV.map(n => '<li><a href="' + n.u + '">' + n.t + '</a></li>').join('');
  const scrim = $('#scrim'), menuOverlay = $('#menuOverlay'), cartDrawer = $('#cartDrawer'), acctDrawer = $('#acctDrawer'), aboutOverlay = $('#aboutOverlay');
  function closeAll(){ scrim.classList.remove('open'); menuOverlay.classList.remove('open'); cartDrawer.classList.remove('open'); acctDrawer.classList.remove('open'); aboutOverlay.classList.remove('open'); }
  $('#menuOpen').onclick = () => { menuOverlay.classList.add('open'); scrim.classList.add('open'); };
  $('#menuClose').onclick = closeAll;
  $('#cartOpen').onclick = () => { scrim.classList.add('open'); cartDrawer.classList.add('open'); loadCart(); };
  $('#cartClose').onclick = closeAll;
  const goAccount = e => { if (e) e.preventDefault(); location.href = '/account'; };
  $('#acctOpen').onclick = goAccount;
  document.querySelectorAll('[data-acct]').forEach(a => a.addEventListener('click', goAccount));
  const openAbout = () => { closeAll(); aboutOverlay.classList.add('open'); };
  document.querySelectorAll('[data-about]').forEach(a => a.addEventListener('click', e => { e.preventDefault(); openAbout(); }));
  $('#aboutClose').onclick = closeAll; $('#aboutX').onclick = closeAll;
  scrim.addEventListener('click', closeAll);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });
  const hdrEl = document.querySelector('header'); const onS = () => hdrEl.classList.toggle('scrolled', scrollY > 8); onS(); addEventListener('scroll', onS, {passive: true});

  /* Shopify cart drawer (cart.js API) */
  const money = v => '₪' + (Number(v) / 100).toLocaleString('he-IL', {maximumFractionDigits: 2}).replace(/\.00$/, '');
  const esc = t => String(t == null ? '' : t).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const cartCall = async (url, body) => (await fetch(url, {method: body ? 'POST' : 'GET', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: body ? JSON.stringify(body) : undefined})).json();
  function renderCart(c){
    $('#cdCount').textContent = c.item_count;
    const body = $('#cdBody'), foot = $('#cdFoot');
    if (!c.items.length){ body.innerHTML = '<div class="cd-empty"><h4>העגלה שלך ריקה</h4><p>הפריטים שתוסיפו יופיעו כאן.</p><a class="btn-line" href="/collections/all">המשך בקנייה</a></div>'; foot.innerHTML = ''; return; }
    body.innerHTML = c.items.map(it => '<div class="cd-item"><a href="' + esc(it.url) + '"><img src="' + esc(it.image) + '" alt=""></a><div><a class="cd-ttl" href="' + esc(it.url) + '">' + esc(it.product_title) + '</a>' + (it.variant_title && it.variant_title !== 'Default Title' ? '<div class="cd-var">' + esc(it.variant_title) + '</div>' : '') +
      '<div class="cd-row"><div class="cd-qty"><button data-k="' + esc(it.key) + '" data-q="' + (it.quantity + 1) + '" aria-label="יותר">+</button><span>' + it.quantity + '</span><button data-k="' + esc(it.key) + '" data-q="' + (it.quantity - 1) + '" aria-label="פחות">−</button></div><span class="cd-pr">' + money(it.final_line_price) + '</span></div>' +
      '<button class="cd-rm" data-k="' + esc(it.key) + '" data-q="0">הסרה</button></div></div>').join('');
    foot.innerHTML = '<div class="cd-sub"><span>סה"כ</span><span>' + money(c.total_price) + '</span></div><a class="cd-go" href="/checkout"><span>לתשלום</span><span>' + money(c.total_price) + '</span></a><a class="cd-more" href="/collections/all">המשך בקנייה</a>';
    body.querySelectorAll('button[data-k]').forEach(b => b.onclick = async () => renderCart(await cartCall('/cart/change.js', {id: b.dataset.k, quantity: Math.max(0, +b.dataset.q)})));
  }
  const loadCart = async () => { try { renderCart(await cartCall('/cart.js')); } catch (e) {} };
  document.addEventListener('cart:updated', loadCart);
  loadCart();
  const nf = $('#newsForm'); if (nf) nf.addEventListener('submit', e => { e.preventDefault(); $('#newsOk').style.display = 'block'; });
})();
</script>

<script>
(function(){
  document.querySelectorAll('button[data-k]').forEach(b => b.onclick = async () => {
    b.disabled = true;
    await fetch('/cart/change.js', {method: 'POST', headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}, body: JSON.stringify({id: b.dataset.k, quantity: Math.max(0, +b.dataset.q)})});
    location.reload();
  });
})();
</script>

