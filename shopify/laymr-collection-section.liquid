  const h = {{ collection.handle | json }};
  const grid = $('#grid'), cards = [...grid.querySelectorAll('.pc')];
  const cats = [{t: 'הכל', u: '/collections/all'}].concat(NAV);
  $('#colCats').innerHTML = cats.map(n => { const ch = decodeURIComponent((n.u.split('/collections/')[1] || '')); return '<a href="' + n.u + '" class="' + (ch === h ? 'on' : '') + '">' + n.t + '</a>'; }).join('');
  const sizes = new Set(); cards.forEach(c => c.dataset.opts.split('|').forEach(o => { if (o && o.trim() && /^(XS|S|M|L|XL|XXL|XXXL|2XL|3XL|4XL|\d+)$/.test(o.trim())) sizes.add(o.trim()); }));
  const order = ['XS','S','M','L','XL','XXL','XXXL','2XL','3XL','4XL'];
  $('#sizeOpts').innerHTML = [...sizes].sort((a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99) || a.localeCompare(b)).map(v => '<button data-v="' + v + '">' + v + '</button>').join('');
  const state = {sort: 'featured', size: null, hideOut: false};
  const draw = () => {
    let l = cards.slice();
    if (state.size) l = l.filter(c => ('|' + c.dataset.opts).includes('|' + state.size + '|'));
    if (state.hideOut) l = l.filter(c => c.dataset.avail === 'true');
    if (state.sort === 'low') l.sort((a, b) => +a.dataset.price - +b.dataset.price);
    if (state.sort === 'high') l.sort((a, b) => +b.dataset.price - +a.dataset.price);
    if (state.sort === 'new') l.sort((a, b) => (b.dataset.new || '').localeCompare(a.dataset.new || ''));
    cards.forEach(c => c.style.display = 'none');
    l.forEach(c => { c.style.display = ''; grid.appendChild(c); });
    $('#count').textContent = l.length;
    $('#empty').hidden = l.length > 0;
  };
  $('#sortOpts').onclick = e => { const b = e.target.closest('button'); if (!b) return; state.sort = b.dataset.v; $('#sortOpts').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b)); draw(); };
  $('#sizeOpts').onclick = e => { const b = e.target.closest('button'); if (!b) return; state.size = state.size === b.dataset.v ? null : b.dataset.v; $('#sizeOpts').querySelectorAll('button').forEach(x => x.classList.toggle('on', x.dataset.v === state.size)); draw(); };
  $('#hideOut').onchange = e => { state.hideOut = e.target.checked; draw(); };
  $('#fpClear').onclick = () => { state.sort = 'featured'; state.size = null; state.hideOut = false; $('#hideOut').checked = false; $('#sortOpts').querySelectorAll('button').forEach((x, i) => x.classList.toggle('on', i === 0)); $('#sizeOpts').querySelectorAll('button').forEach(x => x.classList.remove('on')); draw(); };
  const pop = $('#filterPop'), fbtn = $('#filterBtn');
  fbtn.onclick = () => { const o = pop.classList.toggle('open'); fbtn.setAttribute('aria-expanded', o); };
  document.addEventListener('click', e => { if (!e.target.closest('.col-filter')) pop.classList.remove('open'); });
  draw();
})();
</script>

