.acc-sugg .plist{margin-inline:0;grid-template-columns:repeat(4,1fr)}
.acc-gate[hidden]{display:none}
.acc-gate{min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;padding:40px var(--pad)}
.acc-gate h1{margin:6px 0 0;font-family:var(--font-he);font-weight:600;font-size:clamp(34px,4vw,56px);line-height:1;letter-spacing:-.02em}
