.pfill{position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:22px 22px 20px;background:#17150f 50% 15%/cover no-repeat;color:#fff;overflow:hidden;min-height:0;aspect-ratio:3/4;cursor:pointer;isolation:isolate}
.pf-vid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 15%;z-index:-3;opacity:0;transition:opacity 1s var(--ease)}
.pf-vid.on{opacity:1}
.pf-shade{position:absolute;inset:0;z-index:-2;background:linear-gradient(to top,rgba(20,18,15,.96) 0%,rgba(20,18,15,.78) 45%,rgba(20,18,15,.45) 100%);pointer-events:none}
.pfill:hover .pf-vid{transform:scale(1.04)}
.pf-vid{transition:opacity 1s var(--ease),transform 2.4s var(--ease)}
.pfill::before{content:'';position:absolute;inset:-40%;background:radial-gradient(circle at 30% 20%,rgba(255,255,255,.16),transparent 42%),radial-gradient(circle at 80% 90%,rgba(179,164,146,.35),transparent 46%);animation:pfGlow 9s ease-in-out infinite alternate;z-index:-1}
@keyframes pfGlow{from{transform:translate(0,0) rotate(0deg)}to{transform:translate(8%,6%) rotate(12deg)}}
.pfill::after{content:'LAYMR';position:absolute;right:-8px;bottom:-26px;font-family:var(--font-lat);font-weight:800;font-stretch:118%;font-size:clamp(90px,9vw,150px);line-height:1;letter-spacing:.04em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.1);direction:ltr;pointer-events:none;z-index:-1}
.pf-k{display:flex;align-items:center;gap:10px;font-family:var(--font-lat);font-size:10px;letter-spacing:.36em;text-transform:uppercase;font-weight:600;opacity:.75;direction:ltr;justify-content:flex-end}
.pf-k i{display:block;width:22px;height:1px;background:currentColor}
.pf-mid{display:flex;flex-direction:column;gap:10px}
.pf-big{font-family:var(--font-lat);font-weight:800;font-stretch:112%;font-size:clamp(64px,6.4vw,110px);line-height:.85;letter-spacing:-.03em;direction:ltr;text-align:right;display:block;background:linear-gradient(100deg,#fff 35%,#cfc3ae 50%,#fff 65%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:pfShine 5.5s linear infinite}
@keyframes pfShine{from{background-position:120% 0}to{background-position:-120% 0}}
.pf-big small{font-size:.42em;font-weight:700;vertical-align:top;margin-left:4px;-webkit-text-stroke:1.5px #fff;-webkit-text-fill-color:transparent}
.pf-big.pf-ig{font-size:clamp(36px,3.6vw,56px);letter-spacing:-.02em}
.pf-sub{font-family:var(--font-he);font-size:clamp(15px,1.25vw,19px);font-weight:500;line-height:1.35;max-width:22ch}
.pf-bot{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.pf-code{font-family:var(--font-lat);font-size:11px;letter-spacing:.24em;font-weight:600;border:1px dashed rgba(255,255,255,.45);padding:7px 10px;direction:ltr}
.pf-btn{display:inline-flex;align-items:center;gap:10px;height:40px;padding:0 16px;border-radius:20px;background:#fff;color:var(--ink);font-size:13px;font-weight:500;transition:transform .35s var(--ease),background .3s}
.pf-btn svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:transform .35s var(--ease)}
.pfill:hover .pf-btn{transform:translateY(-2px)}.pfill:hover .pf-btn svg{transform:translateX(-4px)}
.pimg{position:relative;display:block;overflow:hidden;background:#ebe9e4;min-height:0;aspect-ratio:3/4}
.pimg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 20%;display:block;transition:transform 1.4s var(--ease)}
.pimg:hover img{transform:scale(1.04)}
.pimg span{position:absolute;left:12px;bottom:10px;font-family:var(--font-lat);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:#fff;opacity:.85;direction:ltr;text-shadow:0 1px 8px rgba(0,0,0,.4)}
@media(max-width:700px){.pfill{padding:16px 14px 14px}.pf-big{font-size:52px}.pf-sub{font-size:13.5px}.pf-btn{height:34px;padding:0 12px;font-size:12px}.pf-code{font-size:9.5px;padding:5px 7px}.pfill::after{font-size:84px}}
