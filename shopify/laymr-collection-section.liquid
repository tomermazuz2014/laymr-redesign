<main class="pg collection" dir="rtl">
<div class="col-bar">
  <h1 class="col-name"><span id="colTitle">{{ collection.title | escape }}</span><small id="count"></small></h1>
  <nav class="col-cats" id="colCats" aria-label="קטגוריות"></nav>
  <div class="col-filter">
    <button class="filter-btn" id="filterBtn" aria-expanded="false">סינון<svg viewBox="0 0 24 24"><path d="M4 7h16M7 12h10M10 17h4"/></svg></button>
    <div class="filter-pop" id="filterPop">
      <div class="fp-group"><span class="fp-label">מיון</span>
        <div class="fp-opts" id="sortOpts"><button data-v="featured" class="on">מומלצים</button><button data-v="new">חדש ביותר</button><button data-v="low">מחיר: נמוך לגבוה</button><button data-v="high">מחיר: גבוה לנמוך</button></div></div>
      <div class="fp-group"><span class="fp-label">מידה</span><div class="fp-opts fp-sizes" id="sizeOpts"></div></div>
      <div class="fp-group"><label class="fp-check"><input type="checkbox" id="hideOut"> הסתר פריטים שאזלו</label></div>
      <button class="fp-clear" id="fpClear">ניקוי</button>
    </div>
  </div>
</div>
<div class="plist" id="grid">
{% for p in collection.products %}
  <a class="pc" href="{{ p.url }}" data-avail="{{ p.available }}" data-price="{{ p.price }}" data-new="{{ p.published_at }}" data-opts="{% for v in p.variants %}{% if v.available %}{% for o in v.options %}|{{ o }}{% endfor %}|{% endif %}{% endfor %}|">
    <div class="pc-img">{% if p.featured_image %}<img loading="lazy" src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.title | escape }}">{% endif %}</div>
    <div class="pc-panel">
      <span class="pc-title">{{ p.title | escape }}</span>
      <span class="pc-price">{% if p.compare_at_price > p.price %}<s>₪{{ p.compare_at_price | divided_by: 100 }}</s> {% endif %}₪{{ p.price | divided_by: 100 }}</span>
      {% unless p.available %}<span class="pc-out">אזל מהמלאי</span>{% endunless %}
    </div>
  </a>
{% endfor %}
</div>
<div class="empty" id="empty" hidden>אין פריטים שמתאימים לסינון</div>
