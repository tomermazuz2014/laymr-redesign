.acc-pref{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 0;border-top:1px solid var(--line)}
.acc-pref:first-of-type{border-top:0}
.acc-pref b{display:block;font-weight:500;font-size:14.5px}
.acc-pref small{display:block;font-size:12.5px;color:#6f6252;margin-top:3px;line-height:1.5}
.sw{position:relative;width:46px;height:26px;border-radius:13px;background:#d6d1c8;border:0;cursor:pointer;flex:none;transition:background .3s;padding:0}
.sw::after{content:'';position:absolute;top:3px;right:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.2);transition:transform .3s var(--ease)}
.sw.on{background:var(--ink)}.sw.on::after{transform:translateX(-20px)}
.acc-orders-empty{text-align:center;padding:50px 20px 60px;background:#fff;border:1px solid var(--line)}
.acc-orders-empty svg{width:54px;height:54px;fill:none;stroke:var(--ink);stroke-width:.9;stroke-linecap:round;stroke-linejoin:round;opacity:.7;margin-bottom:10px}
.acc-orders-empty h3{margin:0 0 8px;font-family:var(--font-he);font-weight:500;font-size:22px}
.acc-orders-empty p{margin:0 auto 18px;font-size:13.5px;color:#6f6252;max-width:40ch;line-height:1.6}
.acc-sugg{margin-top:30px}
